---
// 華國美學版的入口網站外框，三個版面（首頁、聯絡、CoO）共用：
// 快速連結列、頁首標語、主選單、最新公告跑馬燈、導覽路徑、右側欄、頁尾。
// 頁面內容由 <slot /> 放進 <main>。
//
// 側欄放在 main 之後、畫面右側：DOM 順序就是閱讀順序，鍵盤焦點不會先跳進側欄。
// 站內連結一律相對路徑（見 consts.ts 的 LOCALE_HOME_PATH 說明）。
import MourningNotice from "./MourningNotice.astro";
import ThemeToggle from "./ThemeToggle.astro";
import { COMPANY, SOCIAL, LOCALE_HOME_PATH, type Locale } from "../consts";
import { t } from "../i18n/ui";
import { portal, emphasis, type PortalPage } from "../i18n/portal";
import { cooUrl, APP_URL, REPO_URL } from "../i18n/coo";

interface Crumb {
	label: string;
	href?: string;
}

interface Props {
	locale: Locale;
	page: PortalPage;
	/** 另一個語系的同一頁（站內相對路徑）。 */
	switchHref: string;
	/** 首頁之後的路徑；最後一項是目前頁面，不給 href。 */
	crumbs?: Crumb[];
}

const { locale, page, switchHref, crumbs = [] } = Astro.props;
const p = portal[locale];
const homeHref = LOCALE_HOME_PATH[locale];
const contactHref = locale === "en" ? "/en/contact/" : "/contact/";
const external = t(locale, "link.external");
const hasPhone = COMPANY.phone !== "-";
const telHref = `tel:${COMPANY.phone.replace(/[^\d+]/g, "")}`;
const year = new Date().getFullYear();

const nav: { key: PortalPage; href: string }[] = [
	{ key: "home", href: homeHref },
	{ key: "coo", href: cooUrl(locale, "/") },
	{ key: "features", href: cooUrl(locale, "/features") },
	{ key: "pricing", href: cooUrl(locale, "/pricing") },
	{ key: "contact", href: contactHref },
];

const services = [
	{ label: p.side.services.product, href: cooUrl(locale, "/") },
	{ label: p.side.services.features, href: cooUrl(locale, "/features") },
	{ label: p.side.services.pricing, href: cooUrl(locale, "/pricing") },
	{ label: p.side.services.repo, href: REPO_URL, ext: true },
	{ label: p.side.services.demo, href: APP_URL, ext: true },
	{ label: p.side.services.form, href: contactHref },
	{ label: p.side.services.mail, href: `mailto:${COMPANY.email}` },
];

const trail: Crumb[] = page === "home" ? [{ label: p.crumbs.home }] : [{ label: p.crumbs.home, href: homeHref }, ...crumbs];
---

<a class="skip-link" href="#main">{p.skip}</a>

<MourningNotice locale={locale} />

<div class="portal">
	<nav class="topbar" aria-label={p.topbarAria}>
		<span class="topbar-mark" aria-hidden="true">:::</span>
		<a href={homeHref}>{p.nav.home}</a>
		<span class="sep" aria-hidden="true">｜</span>
		<a href={contactHref}>{t(locale, "nav.contact")}</a>
		<span class="sep" aria-hidden="true">｜</span>
		<a href={switchHref} aria-label={t(locale, "switch.aria")}>{t(locale, "switch.to")}</a>
		<ThemeToggle locale={locale} />
	</nav>

	<header class="masthead">
		<a class="brand" href={homeHref}>
			<img class="brand-logo" src="/logo.png" alt={COMPANY.nameEn} width="583" height="86" />
		</a>
		<p class="masthead-title">
			<span class="mh-name">{p.siteTitle}</span>
			<span class="mh-sub">{p.siteSub}</span>
		</p>
		<p class="masthead-slogan">
			{
				p.slogans.map((s) => (
					<span>
						<span aria-hidden="true">★</span> {s}
					</span>
				))
			}
		</p>
	</header>

	<nav class="mainnav" aria-label={p.navAria}>
		<ul>
			{
				nav.map((item) => (
					<li>
						<a href={item.href} aria-current={item.key === page ? "page" : undefined}>
							{p.nav[item.key]}
						</a>
					</li>
				))
			}
		</ul>
	</nav>

	{/* 跑馬燈可暫停（WCAG 2.2.2）：純 CSS，勾選方塊的狀態由 :has() 讀取。
	    prefers-reduced-motion 時不捲動，直接列出全部公告。 */}
	<section class="ticker" aria-label={p.tickerAria}>
		<span class="ticker-label" aria-hidden="true">{p.tickerLabel}</span>
		<div class="ticker-viewport">
			<ul class="ticker-track">
				{
					p.ticker.map((item) => (
						<li>
							<span aria-hidden="true">◆</span> {item}
						</li>
					))
				}
			</ul>
		</div>
		<label class="ticker-pause">
			<input type="checkbox" class="ticker-toggle" />
			<span>{p.tickerPause}</span>
		</label>
	</section>

	<nav class="crumbs" aria-label={p.crumbsAria}>
		<span class="crumbs-lead">{p.crumbsLead}</span>
		<ol>
			{
				trail.map((c, i) => (
					<li>
						{i > 0 && (
							<span class="crumb-sep" aria-hidden="true">
								＞
							</span>
						)}
						{c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}
					</li>
				))
			}
		</ol>
	</nav>

	<div class="portal-body">
		<main id="main" class="portal-main" tabindex="-1">
			<slot />
		</main>

		<aside class="portal-side">
			<section class="side-box side-services">
				<h2 class="side-title">{p.side.servicesTitle}</h2>
				<ul class="side-links">
					{
						services.map((s) =>
							s.ext ? (
								<li>
									<a href={s.href} target="_blank" rel="noopener noreferrer">
										{s.label}
										<svg
											class="ext"
											viewBox="0 0 24 24"
											width="12"
											height="12"
											aria-hidden="true"
											fill="none"
											stroke="currentColor"
											stroke-width="2"
											stroke-linecap="round"
											stroke-linejoin="round"
										>
											<path d="M7 17 17 7M8 7h9v9" />
										</svg>
										<span class="sr-only">{external}</span>
									</a>
								</li>
							) : (
								<li>
									<a href={s.href}>{s.label}</a>
								</li>
							),
						)
					}
				</ul>
			</section>

			<section class="side-box side-window">
				<h2 class="side-title">{p.side.windowTitle}</h2>
				<table class="side-table">
					<tbody>
						<tr>
							<th scope="row">{t(locale, "contact.info.phone")}</th>
							<td>{hasPhone ? <a href={telHref}>{COMPANY.phone}</a> : COMPANY.phone}</td>
						</tr>
						<tr>
							<th scope="row">{t(locale, "contact.info.email")}</th>
							<td><a href={`mailto:${COMPANY.email}`}>{COMPANY.email}</a></td>
						</tr>
						<tr>
							<th scope="row">LINE</th>
							<td>{COMPANY.lineId}</td>
						</tr>
						<tr>
							<th scope="row">{t(locale, "contact.info.reply")}</th>
							<td>{t(locale, "contact.info.replyValue")}</td>
						</tr>
					</tbody>
				</table>
			</section>

			<section class="side-box side-notice">
				<h2 class="side-title">{p.side.noticeTitle}</h2>
				<ol>
					{
						p.side.notices.map((n) => (
							<li>
								{emphasis(n).map((part) =>
									part.kind === "strong" ? (
										<strong>{part.value}</strong>
									) : part.kind === "em" ? (
										<em>{part.value}</em>
									) : (
										part.value
									),
								)}
							</li>
						))
					}
				</ol>
			</section>

			<section class="side-box side-social">
				<h2 class="side-title">{p.side.socialTitle}</h2>
				<div class="social">
					<a
						href={SOCIAL.instagram}
						target="_blank"
						rel="me noopener noreferrer"
						aria-label={`${COMPANY.shortEn} · Instagram`}
					>
						<svg
							viewBox="0 0 24 24"
							width="20"
							height="20"
							aria-hidden="true"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
						>
							<rect x="2.5" y="2.5" width="19" height="19" rx="5.5"></rect>
							<circle cx="12" cy="12" r="4.2"></circle>
							<circle cx="17.4" cy="6.6" r="1.15" fill="currentColor" stroke="none"></circle>
						</svg>
						<span>Instagram</span>
					</a>
					<a
						href={SOCIAL.threads}
						target="_blank"
						rel="me noopener noreferrer"
						aria-label={`${COMPANY.shortEn} · Threads`}
					>
						<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
							<path
								fill="currentColor"
								d="M12.186 24h-.007c-3.581-.024-6.334-1.205-8.184-3.509C2.35 18.44 1.5 15.586 1.472 12.01v-.017c.03-3.579.879-6.43 2.525-8.482C5.845 1.205 8.6.024 12.18 0h.014c2.746.02 5.043.725 6.826 2.098 1.677 1.29 2.858 3.13 3.509 5.467l-2.04.569c-1.104-3.96-3.898-5.984-8.304-6.015-2.91.022-5.11.936-6.54 2.717C4.307 6.504 3.616 8.914 3.589 12c.027 3.086.718 5.496 2.057 7.166 1.43 1.781 3.63 2.695 6.54 2.717 2.623-.02 4.354-.634 5.798-2.05 1.658-1.626 1.629-3.626 1.116-4.83-.298-.7-.847-1.281-1.591-1.711-.187 1.318-.593 2.362-1.214 3.115-.83 1.006-2.008 1.557-3.501 1.635-1.128.059-2.212-.208-3.053-.752-.994-.643-1.574-1.626-1.634-2.766-.059-1.115.379-2.14 1.234-2.887.821-.717 1.98-1.137 3.44-1.25a13.87 13.87 0 0 1 2.982.126c-.132-.79-.399-1.407-.795-1.844-.535-.591-1.362-.892-2.459-.899h-.034c-.882 0-2.077.243-2.838 1.383l-1.68-1.13c1.019-1.51 2.674-2.341 4.659-2.341h.052c3.316.021 5.293 2.049 5.485 5.538.11.045.216.093.32.144 1.469.69 2.545 1.735 3.109 3.024.786 1.797.833 4.726-1.485 6.998-1.771 1.737-3.921 2.521-6.849 2.521z"
							></path>
						</svg>
						<span>Threads</span>
					</a>
				</div>
			</section>
		</aside>
	</div>

	<footer class="portal-footer">
		<ul class="footer-nav">
			{
				nav.map((item) => (
					<li>
						<a href={item.href}>{p.nav[item.key]}</a>
					</li>
				))
			}
		</ul>
		<slot name="footer" />
		<p>
			<strong>{COMPANY.nameZh}</strong>
			{COMPANY.nameEn}
			<span class="sep" aria-hidden="true">｜</span>
			{t(locale, "taxId")}：{COMPANY.taxId}
		</p>
		<p>
			{p.footer.phone}：{hasPhone ? <a href={telHref}>{COMPANY.phone}</a> : COMPANY.phone}
			<span class="sep" aria-hidden="true">｜</span>
			{p.footer.email}：<a href={`mailto:${COMPANY.email}`}>{COMPANY.email}</a>
			<span class="sep" aria-hidden="true">｜</span>
			{p.footer.reply}：{t(locale, "contact.info.replyValue")}
		</p>
		<p class="footer-fine">{p.footer.maintained}　{p.footer.browsers}</p>
		<p class="footer-fine">© {year} {COMPANY.nameEn} · {t(locale, "rights")}</p>
	</footer>
</div>
