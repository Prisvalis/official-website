---
// 全站頁首：logo 靠左、導覽靠右，下方一條粗線。不固定在頂端（brand-spec §8）。
// 導覽項目由各頁面傳入，連結目標不在這裡決定。
//
// Company of One 產品頁另外傳入 brandText（以文字取代公司 logo）、back（返回官網）
// 與 cta（開始使用）。
import ThemeToggle from "./ThemeToggle.astro";
import { COMPANY, type Locale } from "../consts";
import { t } from "../i18n/ui";

interface NavItem {
	href: string;
	label: string;
	current?: boolean;
}

interface Props {
	locale: Locale;
	homeHref: string;
	switchHref: string;
	nav: NavItem[];
	navLabel?: string;
	/** 以文字取代公司 logo（產品頁用產品名稱）。 */
	brandText?: string;
	/** 導覽最前面的返回連結（產品頁返回官網）。 */
	back?: { href: string; label: string };
	/** 工具列上的主要行動按鈕。 */
	cta?: { href: string; label: string };
}

const { locale, homeHref, switchHref, nav, navLabel, brandText, back, cta } = Astro.props;
---

<header class="site-header">
	<div class="wrap bar">
		{
			brandText ? (
				<a class="brand brand-text" href={homeHref}>
					{brandText}
				</a>
			) : (
				<a class="brand" href={homeHref} aria-label={`${COMPANY.nameEn}｜${COMPANY.nameZh}`}>
					<img class="logo logo-light" src="/logo.svg" alt="" width="297" height="46" />
					<img class="logo logo-dark" src="/logo-dark.svg" alt="" width="297" height="46" />
				</a>
			)
		}

		<div class="tools">
			<a class="lang" href={switchHref} aria-label={t(locale, "switch.aria")}>{t(locale, "switch.to")}</a>
			<ThemeToggle locale={locale} />
			{
				cta && (
					<a class="btn btn-primary cta" href={cta.href}>
						{cta.label}
					</a>
				)
			}
		</div>

		<nav class="nav" aria-label={navLabel}>
			<ul>
				{
					back && (
						<li class="back">
							<a href={back.href}>
								<span aria-hidden="true">←</span> {back.label}
							</a>
						</li>
					)
				}
				{
					nav.map((item) => (
						<li>
							<a href={item.href} aria-current={item.current ? "page" : undefined}>
								{item.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
	</div>
</header>

<style>
	.site-header {
		border-bottom: var(--rule-thick) solid var(--rule);
	}

	/* 第一行 logo 與工具，第二行導覽，全部靠左對齊同一條網格線。 */
	.bar {
		display: grid;
		grid-template-columns: 1fr auto;
		grid-template-areas:
			"brand tools"
			"nav nav";
		align-items: center;
		row-gap: var(--s-2);
		padding-block: var(--s-3) var(--s-2);
	}

	.brand {
		grid-area: brand;
		display: flex;
	}
	.brand-text {
		font-size: 1.5rem;
		font-weight: 700;
		line-height: 1.33;
		text-decoration: none;
	}
	.logo {
		width: auto;
		height: 24px;
	}
	.logo-dark,
	:global(:root[data-theme="dark"]) .logo-light {
		display: none;
	}
	:global(:root[data-theme="dark"]) .logo-dark {
		display: block;
	}

	.tools {
		grid-area: tools;
		display: flex;
		align-items: center;
		gap: var(--s-1);
	}
	.cta {
		min-height: 40px;
		padding: var(--s-1) var(--s-2);
		font-size: 0.875rem;
		white-space: nowrap;
	}
	/* 手機上頁首放不下；頁面開頭本來就有同一個按鈕。 */
	@media (max-width: 479.98px) {
		.cta {
			display: none;
		}
	}
	/* 返回官網：與導覽同一列，用一條直線與其他項目隔開。 */
	.back {
		padding-right: var(--s-3);
		border-right: var(--rule-thin) solid var(--rule);
	}
	.lang {
		font-size: 0.875rem;
		font-weight: 700;
	}

	.nav {
		grid-area: nav;
	}
	.nav ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0 var(--s-3);
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.nav a {
		display: inline-block;
		padding-block: var(--s-1);
		font-size: 0.875rem;
		font-weight: 700;
		text-decoration: none;
	}
	.nav a:hover {
		color: var(--accent);
	}
	/* 目前所在頁面：紅色底線。 */
	.nav a[aria-current="page"] {
		box-shadow: inset 0 -3px 0 var(--accent);
	}
</style>
