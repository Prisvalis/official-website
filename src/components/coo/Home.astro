---
import CoO from "../../layouts/CoO.astro";
import type { Locale } from "../../consts";
import { coo, cooUrl, APP_URL } from "../../i18n/coo";

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const c = coo[locale].home;
---

<CoO locale={locale} page="home">
	<section class="hero">
		<div class="wrap cols">
			<h1>{c.h1}</h1>
			<div class="hero-body">
				<p class="lead">{c.lead}</p>
				<div class="actions">
					<a class="btn btn-primary" href={APP_URL}>{c.ctaFree}</a>
					<a class="btn" href={cooUrl(locale, "/features")}>{c.ctaFeatures}</a>
				</div>
			</div>
		</div>
	</section>

	<section class="section">
		<div class="wrap cols">
			<h2>{c.whyTitle}</h2>
			<p class="prose">{c.whyBody}</p>
		</div>
	</section>

	<section class="section">
		<div class="wrap cols">
			<h2>{c.quote.title}</h2>
			<div class="stack">
				<p>{c.quote.p1}</p>
				<p>{c.quote.p2a}<strong>{c.quote.p2strong}</strong>{c.quote.p2b}</p>
				<ul class="ticks">
					{c.quote.ticks.map((tick) => <li>{tick.a}{tick.b && <strong>{tick.b}</strong>}{tick.c}</li>)}
				</ul>
				<div class="mock" role="img" aria-label={c.quote.mockAria}>
					<div class="mock-title">
						<span>{c.quote.mockTitle}</span>
						<span class="tag">{c.quote.mockTag}</span>
					</div>
					{
						c.quote.rows.map((row) => (
							<div class="mock-row">
								<span class="label">{row.label}</span>
								<span class="value">{row.value}</span>
							</div>
						))
					}
					<div class="mock-row">
						<span class="label"><strong>{c.quote.totalLabel}</strong></span>
						<span class="value">{c.quote.totalValue}</span>
					</div>
					<div class="mock-actions" aria-hidden="true">
						<span class="mock-btn mock-btn-solid">{c.quote.accept}</span>
						<span class="mock-btn">{c.quote.decline}</span>
					</div>
					<p class="mock-note">{c.quote.mockNote}</p>
				</div>
			</div>
		</div>
	</section>

	<section class="section">
		<div class="wrap cols">
			<h2>{c.cash.title}</h2>
			<div class="stack">
				<p>{c.cash.body}</p>
				<ul class="ticks">
					{c.cash.ticks.map((tick) => <li>{tick}</li>)}
				</ul>
				<div class="mock" role="img" aria-label={c.cash.mockAria}>
					<div class="mock-title">
						<span>{c.cash.mockTitle}</span>
						<span class="secondary">{c.cash.mockDate}</span>
					</div>
					{
						c.cash.rows.map((row) => (
							<div class:list={["mock-row", row.warn && "mock-row-warn"]}>
								<span class="label">{row.label}</span>
								<span class="value">{row.value}</span>
							</div>
						))
					}
					<div class="mock-row">
						<span class="label"><strong>{c.cash.totalLabel}</strong></span>
						<span class="value">{c.cash.totalValue}</span>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="section">
		<div class="wrap cols">
			<h2>{c.tax.title}</h2>
			<div class="stack">
				<p>{c.tax.bodyA}<strong>{c.tax.bodyStrong}</strong>{c.tax.bodyB}</p>
				<ul class="ticks">
					{c.tax.ticks.map((tick) => <li>{tick}</li>)}
				</ul>
				<div class="mock" role="img" aria-label={c.tax.mockAria}>
					<div class="mock-title">
						<span>{c.tax.mockTitle}</span>
						<span class="secondary">{c.tax.mockPeriod}</span>
					</div>
					{
						c.tax.rows.map((row) => (
							<div class="mock-row">
								<span class="label">{row.label}</span>
								<span class="value">{row.value}</span>
							</div>
						))
					}
					<div class="mock-row">
						<span class="label"><strong>{c.tax.totalLabel}</strong></span>
						<span class="value">{c.tax.totalValue}</span>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="section">
		<div class="wrap cols">
			<h2>{c.trust.title}</h2>
			<div class="stack">
				<p>{c.trust.body}</p>
				<dl class="defs">
					{
						c.trust.cards.map((card) => (
							<div>
								<dt>{card.title}</dt>
								<dd>
									{card.a}
									{card.strong && <strong>{card.strong}</strong>}
									{card.b}
								</dd>
							</div>
						))
					}
				</dl>
				<h3>{c.trust.adminTitle}</h3>
				<p>{c.trust.adminA}<strong>{c.trust.adminStrong}</strong>{c.trust.adminB}</p>
				<p>{c.trust.adminP2}</p>
				<p><a href={cooUrl(locale, "/features#security")}>{c.trust.adminLink}</a></p>
				<div class="mock" role="img" aria-label={c.trust.noticeAria}>
					<div class="mock-title">
						<span>{c.trust.noticeTitle}</span>
						<span class="tag tag-warn">{c.trust.noticeTag}</span>
					</div>
					<p><strong>{c.trust.noticeHead}</strong></p>
					<p class="mock-note">
						{c.trust.noticeLine1}<br />
						{c.trust.noticeLine2}
					</p>
				</div>
			</div>
		</div>
	</section>

	<section class="section">
		<div class="wrap cols">
			<h2>{c.overviewTitle}</h2>
			<div class="stack">
				<dl class="defs">
					{
						c.overview.map((item) => (
							<div>
								<dt>{item.title}</dt>
								<dd>{item.body}</dd>
							</div>
						))
					}
				</dl>
				<p><a href={cooUrl(locale, "/features")}>{c.overviewLink}</a></p>
			</div>
		</div>
	</section>

	<section class="section" id="status">
		<div class="wrap cols">
			<h2>{c.status.title}</h2>
			<div class="note">
				<p><strong>{c.status.head}</strong></p>
				<p>{c.status.bodyA}<strong>{c.status.bodyStrong}</strong>{c.status.bodyB}</p>
				<p>{c.status.bodyC}</p>
			</div>
		</div>
	</section>

	<section class="section">
		<div class="wrap cols cols-head">
			<h2>{c.finalTitle}</h2>
			<div class="stack">
				<p class="secondary">{c.finalBody}</p>
				<div class="actions">
					<a class="btn btn-primary" href={APP_URL}>{coo[locale].start}</a>
					<a class="btn" href={cooUrl(locale, "/pricing")}>{c.finalCompare}</a>
				</div>
			</div>
		</div>
	</section>
</CoO>
