---
// Company of One 產品首頁。文案在 src/i18n/coo.ts，樣式在 styles/coo.css。
//
// 產品頁的主角是產品本身（brand-spec §9-5）。開頭放的是站方提供的真實截圖
// （public/coo/dashboard.png，營運總覽）；其他畫面還沒有截圖，放標明的佔位，
// 不用 HTML 拼出假介面、不放虛構的金額。佔位的標題沿用 coo.ts 裡原本示意畫面的名稱，
// 截圖到了把 src、width、height 傳給 Shot 即可。
import CoO from "../../layouts/CoO.astro";
import Shot from "./Shot.astro";
import type { Locale } from "../../consts";
import { coo, cooUrl, APP_URL, COO_NAME } from "../../i18n/coo";

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const c = coo[locale].home;
---

<CoO locale={locale} page="home">
	<section class="hero">
		<div class="wrap">
			<div class="cols">
				<h1 class="rise">{c.h1}</h1>
				<div class="hero-body">
					<p class="lead rise rise-2">{c.lead}</p>
					<div class="actions rise rise-3">
						<a class="btn btn-primary" href={APP_URL}>{c.ctaFree}</a>
						<a class="btn" href={cooUrl(locale, "/features")}>{c.ctaFeatures}</a>
					</div>
				</div>
			</div>
			<Shot
				class="hero-shot"
				locale={locale}
				label={COO_NAME}
				aria={c.heroShotAlt}
				src="/coo/dashboard.png"
				width={2557}
				height={1226}
			/>
		</div>
	</section>

	<section class="section">
		<div class="wrap cols">
			<h2>{c.whyTitle}</h2>
			<p class="prose">{c.whyBody}</p>
		</div>
	</section>

	<section class="section">
		<div class="wrap cols">
			<h2>{c.quote.title}</h2>
			<div class="stack">
				<p>{c.quote.p1}</p>
				<p>{c.quote.p2a}<strong>{c.quote.p2strong}</strong>{c.quote.p2b}</p>
				<ul class="ticks">
					{c.quote.ticks.map((tick) => <li>{tick.a}{tick.b && <strong>{tick.b}</strong>}{tick.c}</li>)}
				</ul>
				<Shot locale={locale} label={c.quote.mockTitle} aria={c.quote.mockAria} />
			</div>
		</div>
	</section>

	<section class="section">
		<div class="wrap cols">
			<h2>{c.cash.title}</h2>
			<div class="stack">
				<p>{c.cash.body}</p>
				<ul class="ticks">
					{c.cash.ticks.map((tick) => <li>{tick}</li>)}
				</ul>
				<Shot locale={locale} label={c.cash.mockTitle} aria={c.cash.mockAria} />
			</div>
		</div>
	</section>

	<section class="section">
		<div class="wrap cols">
			<h2>{c.tax.title}</h2>
			<div class="stack">
				<p>{c.tax.bodyA}<strong>{c.tax.bodyStrong}</strong>{c.tax.bodyB}</p>
				<ul class="ticks">
					{c.tax.ticks.map((tick) => <li>{tick}</li>)}
				</ul>
				<Shot locale={locale} label={c.tax.mockTitle} aria={c.tax.mockAria} />
			</div>
		</div>
	</section>

	<section class="section">
		<div class="wrap cols">
			<h2>{c.trust.title}</h2>
			<div class="stack">
				<p>{c.trust.body}</p>
				<dl class="defs">
					{
						c.trust.cards.map((card) => (
							<div>
								<dt>{card.title}</dt>
								<dd>
									{card.a}
									{card.strong && <strong>{card.strong}</strong>}
									{card.b}
								</dd>
							</div>
						))
					}
				</dl>
				<h3>{c.trust.adminTitle}</h3>
				<p>{c.trust.adminA}<strong>{c.trust.adminStrong}</strong>{c.trust.adminB}</p>
				<p>{c.trust.adminP2}</p>
				<p><a href={cooUrl(locale, "/features#security")}>{c.trust.adminLink}</a></p>
				<Shot locale={locale} label={c.trust.noticeTitle} aria={c.trust.noticeAria} />
			</div>
		</div>
	</section>

	<section class="section">
		<div class="wrap cols">
			<h2>{c.overviewTitle}</h2>
			<div class="stack">
				<dl class="defs">
					{
						c.overview.map((item) => (
							<div>
								<dt>{item.title}</dt>
								<dd>{item.body}</dd>
							</div>
						))
					}
				</dl>
				<p><a href={cooUrl(locale, "/features")}>{c.overviewLink}</a></p>
			</div>
		</div>
	</section>

	<section class="section" id="status">
		<div class="wrap cols">
			<h2>{c.status.title}</h2>
			<div class="note">
				<p><strong>{c.status.head}</strong></p>
				<p>{c.status.bodyA}<strong>{c.status.bodyStrong}</strong>{c.status.bodyB}</p>
				<p>{c.status.bodyC}</p>
			</div>
		</div>
	</section>

	<section class="section">
		<div class="wrap cols">
			<h2>{c.finalTitle}</h2>
			<div class="stack">
				<p class="secondary">{c.finalBody}</p>
				<div class="actions">
					<a class="btn btn-primary" href={APP_URL}>{coo[locale].start}</a>
					<a class="btn" href={cooUrl(locale, "/pricing")}>{c.finalCompare}</a>
				</div>
			</div>
		</div>
	</section>
</CoO>
