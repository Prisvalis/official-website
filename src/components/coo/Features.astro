---
import CoO from "../../layouts/CoO.astro";
import type { Locale } from "../../consts";
import { coo, cooUrl, APP_URL } from "../../i18n/coo";

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const c = coo[locale].features;
---

<CoO locale={locale} page="features">
	<section class="hero">
		<div class="wrap cols">
			<h1>{c.h1}</h1>
			<div class="hero-body">
				<p class="lead">{c.lead}</p>
				<div class="note">
					<p class="small">{c.note}</p>
				</div>
			</div>
		</div>
	</section>

	<div class="wrap">
		<nav aria-label={c.tocAria} class="toc">
			{c.sections.map((s) => <a href={`#${s.id}`}>{s.title}</a>)}
		</nav>
	</div>

	{
		c.sections.map((section) => (
			<section id={section.id} class="section">
				<div class="wrap cols">
					<h2>{section.title}</h2>
					<div class="stack">
						{section.intro && <p class="secondary">{section.intro}</p>}
						<dl class="defs">
							{section.items.map((item) => (
								<div>
									<dt>{item.title}</dt>
									<dd>{item.body}</dd>
								</div>
							))}
						</dl>
					</div>
				</div>
			</section>
		))
	}

	<section class="section">
		<div class="wrap cols cols-head">
			<h2>{c.ctaTitle}</h2>
			<div class="stack">
				<p class="secondary">{c.ctaBody}</p>
				<div class="actions">
					<a class="btn btn-primary" href={cooUrl(locale, "/pricing")}>{c.ctaCompare}</a>
					<a class="btn" href={APP_URL}>{c.ctaStart}</a>
				</div>
			</div>
		</div>
	</section>
</CoO>
