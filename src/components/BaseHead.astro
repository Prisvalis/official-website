---
// Global <head>: SEO metadata, social cards, hreflang alternates,
// structured data and a no-flash theme bootstrap. Included on every page.
import "../styles/global.css";
import { SITE, COMPANY, SOCIAL, LOCALE_HOME, type Locale } from "../consts";
import { t } from "../i18n/ui";
import ThemeInit from "./ThemeInit.astro";

interface Props {
	locale: Locale;
	image?: string;
	// 以下三個給首頁以外的頁面覆寫；不傳就維持原本的首頁行為。
	title?: string;
	description?: string;
	alternates?: Record<Locale, string>;
}

const {
	locale,
	image = "/og.svg",
	title: titleProp,
	description: descriptionProp,
	alternates = LOCALE_HOME,
} = Astro.props;

const title = titleProp ?? t(locale, "meta.title");
const description = descriptionProp ?? t(locale, "meta.description");
const ogLocale = t(locale, "og.locale");

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? SITE);
const socialImage = new URL(image, Astro.site ?? SITE);

// Organization structured data for search engines.
const jsonLd = {
	"@context": "https://schema.org",
	"@type": "Organization",
	name: COMPANY.nameEn,
	alternateName: COMPANY.nameZh,
	url: SITE,
	email: COMPANY.email,
	taxID: COMPANY.taxId,
	foundingDate: COMPANY.founded,
	logo: new URL("/favicon.svg", SITE).href,
	sameAs: [SOCIAL.instagram, SOCIAL.threads],
};
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="generator" content={Astro.generator} />
<!-- Site manages its own zh/en switch; suppress the browser's auto-translate prompt -->
<meta name="google" content="notranslate" />
<meta name="theme-color" media="(prefers-color-scheme: light)" content="#000095" />
<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#000060" />

<!-- Canonical + language alternates (hreflang) -->
<link rel="canonical" href={canonicalURL} />
<link rel="alternate" hreflang="zh-Hant" href={alternates["zh-Hant"]} />
<link rel="alternate" hreflang="en" href={alternates["en"]} />
<link rel="alternate" hreflang="x-default" href={alternates["zh-Hant"]} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="robots" content="index, follow" />
<meta name="author" content={COMPANY.nameEn} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content={COMPANY.nameEn} />
<meta property="og:locale" content={ogLocale} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={socialImage} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={socialImage} />

<!-- Structured data -->
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

<!-- No-flash bootstrap: theme and mourning-day attributes are set before paint -->
<ThemeInit />
