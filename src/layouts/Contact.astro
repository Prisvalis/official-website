---
// 聯絡。頁面本身是靜態的（會進 sitemap、走 CDN），
// 送出後由 /api/contact 處理，再轉址回來帶上狀態參數。
//
// 華國美學版：外框由 PortalShell 提供；表單改成行政表格式的「欄名格 + 輸入格」。
// 錯誤橫幅照舊：每一種錯誤都有文字說明，不只靠紅色。
import BaseHead from "../components/BaseHead.astro";
import PortalShell from "../components/PortalShell.astro";
import WordArt from "../components/WordArt.astro";
import { portal } from "../i18n/portal";
import { COMPANY, CONTACT, CONTACT_CATEGORIES, SITE, SOCIAL, type Locale } from "../consts";
import { t } from "../i18n/ui";

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const otherLocale: Locale = locale === "zh-Hant" ? "en" : "zh-Hant";

const PATHS: Record<Locale, string> = { "zh-Hant": "/contact/", en: "/en/contact/" };
const alternates: Record<Locale, string> = {
	"zh-Hant": new URL(PATHS["zh-Hant"], SITE).href,
	en: new URL(PATHS.en, SITE).href,
};

// 還沒開通的聯絡方式在 consts 裡是 "-"。有真值才做成可點的連結，
// 否則點下去會開出一個 tel:- 這種沒有意義的動作。
const hasPhone = COMPANY.phone !== "-";
const hasLine = COMPANY.lineId !== "-";
// tel: 只吃數字與 +，把排版用的分隔符去掉。
const telHref = `tel:${COMPANY.phone.replace(/[^\d+]/g, "")}`;
// 從個人檔案網址推回帳號，省得同一個字串在 consts 裡放兩份。
const instagramHandle = `@${SOCIAL.instagram.split("/").filter(Boolean).pop()}`;

const homeHref = locale === "en" ? "/en/" : "/";
---

<!doctype html>
<html lang={t(locale, "html.lang")}>
	<head>
		<BaseHead
			locale={locale}
			title={t(locale, "contact.meta.title")}
			description={t(locale, "contact.meta.description")}
			alternates={alternates}
		/>
	</head>
	<body>
		<PortalShell
			locale={locale}
			page="contact"
			switchHref={PATHS[otherLocale]}
			crumbs={[{ label: portal[locale].crumbs.contact }]}
		>
			<div class="contact-page">
			<section class="hero contact-hero">
				<WordArt text={t(locale, "contact.heading")} class="title" />
				<p class="lead">{t(locale, "contact.lead")}</p>
			</section>

			{/* 四種狀態都先渲染好再由 script 打開對應的那個。
			    比起用 JS 組字串，這樣文案仍然只有一份，也不會有版面跳動。 */}
			<div class="banners" aria-live="polite">
				<div class="banner banner-ok" data-status="sent" hidden>
					<strong>{t(locale, "contact.sent.title")}</strong>
					<span>{t(locale, "contact.sent.body")}</span>
				</div>
				<div class="banner banner-err" data-status="invalid" hidden>
					<span>{t(locale, "contact.error.invalid")}</span>
				</div>
				<div class="banner banner-err" data-status="captcha" hidden>
					<span>{t(locale, "contact.error.captcha")}</span>
				</div>
				<div class="banner banner-err" data-status="failed" hidden>
					<span>{t(locale, "contact.error.failed")}</span>
					<a href={`mailto:${COMPANY.email}`}>{t(locale, "contact.error.mailto")}</a>
				</div>
			</div>

			<div class="layout">
				<aside class="info">
					<h2 class="block-title">{t(locale, "contact.info.title")}</h2>

					<dl class="info-list">
						<div class="info-item">
							<dt>{t(locale, "contact.info.phone")}</dt>
							<dd>
								{
									hasPhone ? (
										<a href={telHref}>{COMPANY.phone}</a>
									) : (
										<span class="empty">
											{COMPANY.phone}
											<span class="sr-only">{t(locale, "contact.info.pending")}</span>
										</span>
									)
								}
							</dd>
						</div>

						<div class="info-item">
							<dt>{t(locale, "contact.info.email")}</dt>
							<dd><a href={`mailto:${COMPANY.email}`}>{COMPANY.email}</a></dd>
						</div>

						<div class="info-item">
							<dt>{t(locale, "contact.info.line")}</dt>
							<dd>
								{
									hasLine ? (
										<span>{COMPANY.lineId}</span>
									) : (
										<span class="empty">
											{COMPANY.lineId}
											<span class="sr-only">{t(locale, "contact.info.pending")}</span>
										</span>
									)
								}
							</dd>
						</div>

						<div class="info-item">
							<dt>{t(locale, "contact.info.instagram")}</dt>
							<dd>
								<a href={SOCIAL.instagram} rel="me noopener" target="_blank">{instagramHandle}</a>
							</dd>
						</div>

						<div class="info-item">
							<dt>{t(locale, "contact.info.reply")}</dt>
							<dd>{t(locale, "contact.info.replyValue")}</dd>
						</div>
					</dl>
				</aside>

				<form class="form" method="post" action="/api/contact">
					<h2 class="block-title">{t(locale, "contact.form.title")}</h2>

					<input type="hidden" name="locale" value={locale} />

					{/* 蜜罐。真人看不到也 tab 不到，填了就是機器人。
					    欄位名稱刻意避開表單真正使用的名字（company 已經是公司名稱了）。 */}
					<div class="hp" aria-hidden="true">
						<label for="website">Website</label>
						<input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
					</div>

					<div class="row">
						<div class="field">
							<label for="name">{t(locale, "contact.name")}</label>
							<input
								id="name"
								name="name"
								type="text"
								required
								maxlength="100"
								autocomplete="name"
								placeholder={t(locale, "contact.namePlaceholder")}
							/>
						</div>

						<div class="field">
							<label for="email">{t(locale, "contact.email")}</label>
							<input
								id="email"
								name="email"
								type="email"
								required
								maxlength="254"
								autocomplete="email"
								aria-describedby="email-hint"
								placeholder="you@example.com"
							/>
						</div>
					</div>

					<p id="email-hint" class="hint">{t(locale, "contact.emailHint")}</p>

					<div class="row">
						<div class="field">
							<label for="phone">
								{t(locale, "contact.phone")}
								<span class="optional">· {t(locale, "contact.optional")}</span>
							</label>
							<input
								id="phone"
								name="phone"
								type="tel"
								maxlength="40"
								autocomplete="tel"
								placeholder={t(locale, "contact.phonePlaceholder")}
							/>
						</div>

						<div class="field">
							<label for="company">
								{t(locale, "contact.company")}
								<span class="optional">· {t(locale, "contact.optional")}</span>
							</label>
							<input
								id="company"
								name="company"
								type="text"
								maxlength="120"
								autocomplete="organization"
								placeholder={t(locale, "contact.companyPlaceholder")}
							/>
						</div>
					</div>

					<div class="field">
						<label for="category">{t(locale, "contact.category")}</label>
						<div class="select-wrap">
							<select id="category" name="category" required>
								<option value="" disabled selected>
									{t(locale, "contact.categoryPlaceholder")}
								</option>
								{
									CONTACT_CATEGORIES.map((category) => (
										<option value={category}>{t(locale, `contact.category.${category}`)}</option>
									))
								}
							</select>
						</div>
					</div>

					<div class="field">
						<label for="message">{t(locale, "contact.message")}</label>
						<textarea
							id="message"
							name="message"
							required
							minlength="10"
							maxlength="5000"
							rows="7"
							placeholder={t(locale, "contact.messagePlaceholder")}></textarea>
					</div>

					<div class="cf-turnstile" data-sitekey={CONTACT.turnstileSiteKey}></div>

					<button class="btn btn-primary submit" type="submit">{t(locale, "contact.submit")}</button>

					<p class="hint">{t(locale, "contact.privacy")}</p>
				</form>
			</div>

			<p class="back">
				<a href={homeHref}>{t(locale, "contact.back")}</a>
			</p>
			</div>
		</PortalShell>

		<script
			src="https://challenges.cloudflare.com/turnstile/v0/api.js"
			async
			defer
			is:inline></script>

		<script is:inline>
			(function () {
				// /api/contact 處理完會轉址回來帶上狀態。只認固定的幾個值，
				// 不把網址裡的字串放進畫面。
				var params = new URLSearchParams(location.search);
				var status = params.get("sent") === "1" ? "sent" : params.get("error");
				var allowed = ["sent", "invalid", "captcha", "failed"];
				if (allowed.indexOf(status) === -1) return;

				var banner = document.querySelector('[data-status="' + status + '"]');
				if (banner) banner.hidden = false;
				if (status === "sent") {
					var form = document.querySelector("form");
					if (form) form.reset();
				}
				// 把參數從網址上抹掉，重新整理就不會又看到同一條訊息。
				history.replaceState(null, "", location.pathname);
			})();
		</script>

		<style>
			.contact-hero {
				margin-bottom: 0;
			}
			.lead {
				max-width: 46em;
				margin-top: 8.6px;
				font-size: 15.4px;
			}

			/* 錯誤與成功都有文字說明；顏色只是輔助。 */
			.banner {
				display: flex;
				flex-wrap: wrap;
				gap: 3px 8.4px;
				align-items: baseline;
				margin-top: 10.4px;
				padding: 7.6px 11.2px 7.2px 10.4px;
				border: 2px solid var(--ok-border);
				background: var(--ok-bg);
				font-family: var(--font-ui);
			}
			/* display:flex 的優先權高過瀏覽器內建的 [hidden]{display:none}，
			   沒有這條的話四種狀態會同時出現在畫面上。 */
			.banner[hidden] {
				display: none;
			}
			.banner-ok::before {
				content: "◎";
				color: var(--ok-border);
				font-weight: 700;
			}
			.banner-err {
				border-color: var(--roc-red);
				background: var(--err-bg);
			}
			.banner-err::before {
				content: "※";
				color: var(--roc-red);
				font-weight: 700;
			}
			:root[data-theme="dark"] .banner-err::before {
				color: #ff9d9d;
			}

			/* 左：服務窗口資訊；右：線上詢問表單。窄螢幕收成一欄，DOM 順序即閱讀順序。 */
			.layout {
				display: grid;
				gap: 10.6px 11.4px;
				margin-top: 10.8px;
				align-items: start;
			}
			@media (min-width: 56rem) {
				.layout {
					grid-template-columns: minmax(0, 15.5rem) minmax(0, 1fr);
				}
			}
			.info,
			.form {
				border: 1px solid var(--border);
				background: var(--panel);
			}
			.form {
				border-color: var(--border-dark);
			}
			.block-title {
				padding: 4px 9.6px 3.4px;
				background: linear-gradient(to bottom, var(--roc-blue-3), var(--roc-blue-2) 55%, var(--roc-blue));
				border-bottom: 2px solid var(--roc-gold);
				color: #ffffff;
				font-size: 17.4px;
				text-shadow: 1px 1px 0 #000040;
			}
			.info .block-title {
				background: linear-gradient(to bottom, hsl(0 80% 52%), var(--roc-red-2));
				border-bottom-color: #500000;
				text-shadow: 1px 1px 0 #400000;
			}
			.block-title::before {
				content: "【";
			}
			.block-title::after {
				content: "】";
			}

			.info-list {
				margin: 0;
				font-family: var(--font-ui);
				font-size: 13.6px;
			}
			.info-item {
				display: grid;
				grid-template-columns: 6.4em minmax(0, 1fr);
				border-bottom: 1px solid var(--border);
			}
			.info-item:last-child {
				border-bottom: 0;
			}
			.info-item dt {
				padding: 5.2px 6.4px;
				background: var(--roc-blue-pale);
				border-right: 1px solid var(--border);
				font-weight: 700;
			}
			.info-item dd {
				margin: 0;
				padding: 5.2px 7.6px 4.8px;
				overflow-wrap: anywhere;
			}
			.empty {
				color: var(--muted);
			}

			/* 表單：行政表格式。每個欄位一列，左邊灰底欄名。 */
			.form {
				display: grid;
				gap: 0;
			}
			.form > :not(.block-title):not(.hp),
			.row > .field {
				margin-inline: 10.2px 9.6px;
			}
			.row {
				display: contents;
			}
			.field {
				display: grid;
				gap: 0;
				min-width: 0;
				margin-top: -1px;
				border: 1px solid var(--border);
			}
			.field:has(#name) {
				margin-top: 10.4px;
			}
			@media (min-width: 34rem) {
				.field {
					grid-template-columns: 9.2em minmax(0, 1fr);
				}
			}
			.field > :not(label) {
				justify-self: stretch;
				min-width: 0;
				margin: 5.4px 6.6px 5.8px 6px;
			}
			label {
				display: block;
				padding: 6.2px 8px 5.6px;
				background: var(--roc-blue-pale);
				font-family: var(--font-ui);
				font-size: 13.6px;
				font-weight: 700;
			}
			@media (min-width: 34rem) {
				.field > label {
					border-right: 1px solid var(--border);
				}
			}
			label::before {
				content: "＊";
				color: var(--roc-red);
			}
			:root[data-theme="dark"] label::before {
				color: #ff9d9d;
			}
			label:has(.optional)::before {
				content: "";
			}
			.optional {
				color: var(--muted);
				font-weight: 400;
			}
			input[type="text"],
			input[type="email"],
			input[type="tel"],
			select,
			textarea {
				width: auto;
				padding: 4.4px 6.2px;
				border: 2px inset hsl(220 10% 75%);
				border-radius: 0;
				background: #ffffff;
				color: #1c1c1c;
				font-family: var(--font-ming);
				font-size: 15px;
			}
			:root[data-theme="dark"] input[type="text"],
			:root[data-theme="dark"] input[type="email"],
			:root[data-theme="dark"] input[type="tel"],
			:root[data-theme="dark"] select,
			:root[data-theme="dark"] textarea {
				border-color: hsl(228 30% 40%);
				background: hsl(230 60% 8%);
				color: var(--text);
			}
			input:focus,
			select:focus,
			textarea:focus {
				background: hsl(52 100% 95%);
			}
			:root[data-theme="dark"] input:focus,
			:root[data-theme="dark"] select:focus,
			:root[data-theme="dark"] textarea:focus {
				background: hsl(229 50% 16%);
			}
			input::placeholder,
			textarea::placeholder {
				color: #6b6b6b;
				opacity: 1;
			}
			:root[data-theme="dark"] input::placeholder,
			:root[data-theme="dark"] textarea::placeholder {
				color: #9aa2c0;
			}
			select {
				cursor: pointer;
			}
			select:invalid {
				color: #6b6b6b;
			}
			.select-wrap {
				display: block;
			}
			.select-wrap select {
				width: 100%;
			}
			textarea {
				resize: vertical;
				min-height: 8rem;
			}
			/* 使用者動過之後才標記。錯誤不只換顏色：框加粗、底色改淡紅。 */
			input:user-invalid,
			select:user-invalid,
			textarea:user-invalid {
				border: 2px solid var(--roc-red);
				background: var(--err-bg);
			}
			.hint {
				padding: 4.2px 2px 0;
				color: var(--muted);
				font-family: var(--font-ui);
				font-size: 12.8px;
				line-height: 1.6;
			}
			.hint::before {
				content: "※ ";
			}
			#email-hint {
				padding-bottom: 4px;
			}

			/* 蜜罐。不用 display:none，有些機器人會跳過被隱藏的欄位。 */
			.hp {
				position: absolute;
				left: -9999px;
				width: 1px;
				height: 1px;
				overflow: hidden;
			}

			.cf-turnstile {
				margin-top: 10.2px;
			}
			.submit {
				justify-self: start;
				margin-top: 10.6px;
			}
			.form > .hint:last-child {
				margin-bottom: 10px;
			}

			.back {
				margin-top: 11.4px;
				font-family: var(--font-ui);
				font-size: 13.6px;
			}
			.back::before {
				content: "← ";
			}

			@media (max-width: 30rem) {
				.submit {
					justify-self: stretch;
					justify-content: center;
				}
			}
		</style>
	</body>
</html>
