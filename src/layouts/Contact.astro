---
// 聯絡。頁面本身是靜態的（會進 sitemap、走 CDN），
// 送出後由 /api/contact 處理，再轉址回來帶上狀態參數。
//
// 設計依 docs/brand-spec.md（Linear recipe）：左欄是其他聯絡方式，右欄是表單。
// 表單是受保護契約（CLAUDE.md）：欄位的 name、順序、必填與驗證規則、送出目標與
// Turnstile 都不得更動，改版只動外觀。共用樣式在 styles/global.css。
import BaseHead from "../components/BaseHead.astro";
import MourningNotice from "../components/MourningNotice.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { COMPANY, CONTACT, CONTACT_CATEGORIES, SITE, SOCIAL, type Locale } from "../consts";
import { t } from "../i18n/ui";
import { cooUrl, COO_NAME } from "../i18n/coo";
import { about, ABOUT_PATH } from "../i18n/about";

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const otherLocale: Locale = locale === "zh-Hant" ? "en" : "zh-Hant";

const PATHS: Record<Locale, string> = { "zh-Hant": "/contact/", en: "/en/contact/" };
const alternates: Record<Locale, string> = {
	"zh-Hant": new URL(PATHS["zh-Hant"], SITE).href,
	en: new URL(PATHS.en, SITE).href,
};

// 還沒開通的聯絡方式在 consts 裡是 "-"。有真值才做成可點的連結，
// 否則點下去會開出一個 tel:- 這種沒有意義的動作。
const hasPhone = COMPANY.phone !== "-";
const hasLine = COMPANY.lineId !== "-";
// tel: 只吃數字與 +，把排版用的分隔符去掉。
const telHref = `tel:${COMPANY.phone.replace(/[^\d+]/g, "")}`;
// 從個人檔案網址推回帳號，省得同一個字串在 consts 裡放兩份。
const instagramHandle = `@${SOCIAL.instagram.split("/").filter(Boolean).pop()}`;

const homeHref = locale === "en" ? "/en/" : "/";
const nav = [
	{ href: homeHref, label: t(locale, "contact.back") },
	{ href: ABOUT_PATH[locale], label: about[locale].navLabel },
	{ href: cooUrl(locale, "/"), label: COO_NAME },
	{ href: PATHS[locale], label: t(locale, "contact.heading"), current: true },
];
---

<!doctype html>
<html lang={t(locale, "html.lang")}>
	<head>
		<BaseHead
			locale={locale}
			title={t(locale, "contact.meta.title")}
			description={t(locale, "contact.meta.description")}
			alternates={alternates}
		/>
	</head>
	<body>
		<MourningNotice locale={locale} />
		<SiteHeader locale={locale} homeHref={homeHref} switchHref={PATHS[otherLocale]} nav={nav} />

		<main id="main">
			<header class="page-head">
				<div class="wrap">
					<h1 class="rise">{t(locale, "contact.heading")}</h1>
					<p class="lead measure rise rise-2">{t(locale, "contact.lead")}</p>
				</div>
			</header>

			<section class="section">
				<div class="wrap split">
					<aside class="split-head">
						<h2 class="info-title">{t(locale, "contact.info.title")}</h2>
						<dl class="info">
							<div>
								<dt>{t(locale, "contact.info.phone")}</dt>
								<dd>
									{
										hasPhone ? (
											<a href={telHref}>{COMPANY.phone}</a>
										) : (
											<span class="empty">
												{COMPANY.phone}
												<span class="sr-only">{t(locale, "contact.info.pending")}</span>
											</span>
										)
									}
								</dd>
							</div>
							<div>
								<dt>{t(locale, "contact.info.email")}</dt>
								<dd><a href={`mailto:${COMPANY.email}`}>{COMPANY.email}</a></dd>
							</div>
							<div>
								<dt>{t(locale, "contact.info.line")}</dt>
								<dd>
									{
										hasLine ? (
											<a href={COMPANY.lineUrl} target="_blank" rel="noopener noreferrer">
												{COMPANY.lineId}
												<span class="sr-only">{t(locale, "link.external")}</span>
											</a>
										) : (
											<span class="empty">
												{COMPANY.lineId}
												<span class="sr-only">{t(locale, "contact.info.pending")}</span>
											</span>
										)
									}
								</dd>
							</div>
							<div>
								<dt>{t(locale, "contact.info.instagram")}</dt>
								<dd>
									<a href={SOCIAL.instagram} rel="me noopener" target="_blank">{instagramHandle}</a>
								</dd>
							</div>
							<div>
								<dt>{t(locale, "contact.info.reply")}</dt>
								<dd>{t(locale, "contact.info.replyValue")}</dd>
							</div>
						</dl>
					</aside>

					<div class="split-body" id="form">
						{/* 四種狀態都先渲染好再由 script 打開對應的那個。
						    比起用 JS 組字串，這樣文案仍然只有一份，也不會有版面跳動。 */}
						<div class="banners" aria-live="polite">
							<div class="banner banner-ok" data-status="sent" hidden>
								<strong>{t(locale, "contact.sent.title")}</strong>
								<span>{t(locale, "contact.sent.body")}</span>
							</div>
							<div class="banner banner-err" data-status="invalid" hidden>
								<span>{t(locale, "contact.error.invalid")}</span>
							</div>
							<div class="banner banner-err" data-status="captcha" hidden>
								<span>{t(locale, "contact.error.captcha")}</span>
							</div>
							<div class="banner banner-err" data-status="failed" hidden>
								<span>{t(locale, "contact.error.failed")}</span>
								<a href={`mailto:${COMPANY.email}`}>{t(locale, "contact.error.mailto")}</a>
							</div>
						</div>

						<form class="form" method="post" action="/api/contact">
							<h2 class="form-title">{t(locale, "contact.form.title")}</h2>

							<input type="hidden" name="locale" value={locale} />

							{/* 蜜罐。真人看不到也 tab 不到，填了就是機器人。
							    欄位名稱刻意避開表單真正使用的名字（company 已經是公司名稱了）。 */}
							<div class="hp" aria-hidden="true">
								<label for="website">Website</label>
								<input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
							</div>

							<div class="row">
								<div class="field">
									<label for="name">{t(locale, "contact.name")}</label>
									<input
										id="name"
										name="name"
										type="text"
										required
										maxlength="100"
										autocomplete="name"
										placeholder={t(locale, "contact.namePlaceholder")}
									/>
								</div>

								<div class="field">
									<label for="email">{t(locale, "contact.email")}</label>
									<input
										id="email"
										name="email"
										type="email"
										required
										maxlength="254"
										autocomplete="email"
										aria-describedby="email-hint"
										placeholder="you@example.com"
									/>
								</div>
							</div>

							<p id="email-hint" class="hint">{t(locale, "contact.emailHint")}</p>

							<div class="row">
								<div class="field">
									<label for="phone">
										{t(locale, "contact.phone")}
										<span class="optional">· {t(locale, "contact.optional")}</span>
									</label>
									<input
										id="phone"
										name="phone"
										type="tel"
										maxlength="40"
										autocomplete="tel"
										placeholder={t(locale, "contact.phonePlaceholder")}
									/>
								</div>

								<div class="field">
									<label for="company">
										{t(locale, "contact.company")}
										<span class="optional">· {t(locale, "contact.optional")}</span>
									</label>
									<input
										id="company"
										name="company"
										type="text"
										maxlength="120"
										autocomplete="organization"
										placeholder={t(locale, "contact.companyPlaceholder")}
									/>
								</div>
							</div>

							<div class="field">
								<label for="category">{t(locale, "contact.category")}</label>
								<div class="select-wrap">
									<select id="category" name="category" required>
										<option value="" disabled selected>
											{t(locale, "contact.categoryPlaceholder")}
										</option>
										{
											CONTACT_CATEGORIES.map((category) => (
												<option value={category}>{t(locale, `contact.category.${category}`)}</option>
											))
										}
									</select>
								</div>
							</div>

							<div class="field">
								<label for="message">{t(locale, "contact.message")}</label>
								<textarea
									id="message"
									name="message"
									required
									minlength="10"
									maxlength="5000"
									rows="7"
									placeholder={t(locale, "contact.messagePlaceholder")}></textarea>
							</div>

							<div class="cf-turnstile" data-sitekey={CONTACT.turnstileSiteKey}></div>

							<button class="btn btn-primary submit" type="submit" data-busy={t(locale, "contact.submitting")}>
								{t(locale, "contact.submit")}
							</button>

							<p class="hint">{t(locale, "contact.privacy")}</p>
						</form>
					</div>
				</div>
			</section>
		</main>

		<SiteFooter
			locale={locale}
			links={[
				{ href: homeHref, label: t(locale, "contact.back") },
				{ href: ABOUT_PATH[locale], label: about[locale].navLabel },
				{ href: cooUrl(locale, "/"), label: COO_NAME },
			]}
		/>

		<script
			src="https://challenges.cloudflare.com/turnstile/v0/api.js"
			async
			defer
			is:inline></script>

		<script is:inline>
			(function () {
				// /api/contact 處理完會轉址回來帶上狀態。只認固定的幾個值，
				// 不把網址裡的字串放進畫面。
				var params = new URLSearchParams(location.search);
				var status = params.get("sent") === "1" ? "sent" : params.get("error");
				var allowed = ["sent", "invalid", "captcha", "failed"];
				if (allowed.indexOf(status) !== -1) {
					var banner = document.querySelector('[data-status="' + status + '"]');
					if (banner) banner.hidden = false;
					if (status === "sent") {
						var sentForm = document.querySelector("form");
						if (sentForm) sentForm.reset();
					}
					// 把參數從網址上抹掉，重新整理就不會又看到同一條訊息。
					history.replaceState(null, "", location.pathname);
				}

				// 送出中：通過瀏覽器驗證、真的要送出時才停用按鈕，避免重複送出。
				// 頁面從上一頁快取回來時（pageshow persisted）要恢復原狀。
				var form = document.querySelector("form.form");
				var button = form && form.querySelector(".submit");
				if (!form || !button) return;
				var idle = button.textContent;
				form.addEventListener("submit", function () {
					button.disabled = true;
					button.setAttribute("aria-busy", "true");
					button.textContent = button.dataset.busy;
				});
				window.addEventListener("pageshow", function (e) {
					if (!e.persisted) return;
					button.disabled = false;
					button.removeAttribute("aria-busy");
					button.textContent = idle;
				});
			})();
		</script>

		<style>
			/* --- 左欄：其他聯絡方式 --- */
			.info-title {
				font-size: 1.25rem;
				line-height: 1.4;
			}
			.info {
				margin: var(--s-4) 0 0;
				border-top: 1px solid var(--hairline);
			}
			.info > div {
				padding-block: var(--s-3);
				border-bottom: 1px solid var(--hairline);
			}
			.info dt {
				color: var(--text-2);
				font-size: 0.8125rem;
			}
			.info dd {
				margin: var(--s-1) 0 0;
				font-weight: 500;
				overflow-wrap: anywhere;
			}
			/* 還沒開通的欄位。視覺上淡化，但螢幕閱讀器仍會唸出 .sr-only 的說明。 */
			.empty {
				color: var(--text-2);
			}

			/* --- 狀態訊息：不用第二個顏色，靠文字與記號說明（brand-spec §10）--- */
			.banner {
				display: flex;
				flex-wrap: wrap;
				align-items: baseline;
				gap: var(--s-1) var(--s-2);
				padding: var(--s-4) var(--s-5);
				border: 1px solid var(--hairline);
				border-radius: var(--radius-m);
				background: var(--surface-1);
			}
			/* display:flex 的優先權高過瀏覽器內建的 [hidden]{display:none}，
			   沒有這條的話四種狀態會同時出現在畫面上。 */
			.banner[hidden] {
				display: none;
			}
			.banner::before {
				content: "";
				flex: none;
				width: 6px;
				height: 6px;
				background: var(--accent);
				transform: translateY(-2px);
			}
			/* 錯誤：強調色外框，文字本身說明發生什麼事，不只靠顏色。 */
			.banner-err {
				border-color: var(--accent);
			}

			/* --- 表單 --- */
			.form {
				display: grid;
				grid-template-columns: minmax(0, 1fr);
				gap: var(--s-5);
				padding: var(--s-5);
				border: 1px solid var(--hairline);
				border-radius: var(--radius-l);
				background: var(--surface-1);
				box-shadow: var(--shadow);
			}
			@media (min-width: 760px) {
				.form {
					padding: var(--s-6);
				}
			}
			.form-title {
				font-size: 1.25rem;
				line-height: 1.4;
			}
			.row {
				display: grid;
				grid-template-columns: minmax(0, 1fr);
				gap: var(--s-5);
			}
			@media (min-width: 34rem) {
				.row {
					grid-template-columns: repeat(2, minmax(0, 1fr));
				}
			}
			.field {
				display: grid;
				gap: var(--s-2);
				min-width: 0;
			}
			label {
				font-size: 0.875rem;
				font-weight: 500;
			}
			/* 必填欄位：標籤後面加強調色記號，螢幕閱讀器從 required 屬性得知。 */
			.field:has(:required) > label::after {
				content: " *" / "";
				color: var(--accent);
			}
			.optional {
				color: var(--text-2);
				font-weight: 400;
			}
			input[type="text"],
			input[type="email"],
			input[type="tel"],
			select,
			textarea {
				width: 100%;
				min-height: 40px;
				padding: var(--s-2) var(--s-3);
				border: 1px solid var(--hairline);
				border-radius: var(--radius-s);
				background: var(--ground);
				color: var(--text);
				font: inherit;
				font-size: 0.9375rem;
				transition: border-color 150ms ease-out;
			}
			input:hover,
			select:hover,
			textarea:hover {
				border-color: color-mix(in srgb, var(--text) 24%, transparent);
			}
			input::placeholder,
			textarea::placeholder {
				color: var(--text-2);
				opacity: 1;
			}
			input:focus-visible,
			select:focus-visible,
			textarea:focus-visible {
				border-color: var(--accent);
				outline-offset: 0;
			}

			.select-wrap {
				position: relative;
			}
			select {
				appearance: none;
				padding-right: var(--s-6);
				cursor: pointer;
			}
			/* 下拉箭頭：一個細線 V 字。 */
			.select-wrap::after {
				content: "";
				position: absolute;
				right: var(--s-4);
				top: 50%;
				width: 7px;
				height: 7px;
				border-right: 1.5px solid var(--text-2);
				border-bottom: 1.5px solid var(--text-2);
				transform: translateY(-70%) rotate(45deg);
				pointer-events: none;
			}
			/* 尚未選擇時，顯示文字比照 placeholder 淡化 */
			select:invalid {
				color: var(--text-2);
			}

			textarea {
				resize: vertical;
				min-height: 10rem;
			}
			/* 只在使用者動過之後才標記；標籤上本來就有必填記號，不只靠顏色。 */
			input:user-invalid,
			select:user-invalid,
			textarea:user-invalid {
				border-color: var(--accent);
				box-shadow: 0 0 0 1px var(--accent);
			}
			.hint {
				margin-top: calc(-1 * var(--s-3));
				color: var(--text-2);
				font-size: 0.8125rem;
				line-height: 1.6;
			}
			.form > .hint:last-child {
				margin-top: 0;
			}

			/* 蜜罐。不用 display:none，有些機器人會跳過被隱藏的欄位。 */
			.hp {
				position: absolute;
				left: -9999px;
				width: 1px;
				height: 1px;
				overflow: hidden;
			}

			.submit {
				justify-self: start;
			}
			.submit:disabled {
				cursor: progress;
				opacity: 0.7;
			}
			@media (max-width: 30rem) {
				.submit {
					justify-self: stretch;
					justify-content: center;
				}
			}
		</style>
	</body>
</html>
