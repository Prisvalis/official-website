---
// 聯絡。頁面本身是靜態的（會進 sitemap、走 CDN），
// 送出後由 /api/contact 處理，再轉址回來帶上狀態參數。
//
// 版面沿用首頁的語彙（styles/global.css）：左對齊、不對稱、只用留白與 1px 實線。
import BaseHead from "../components/BaseHead.astro";
import MourningNotice from "../components/MourningNotice.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import { COMPANY, CONTACT, CONTACT_CATEGORIES, SITE, SOCIAL, type Locale } from "../consts";
import { t } from "../i18n/ui";

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const otherLocale: Locale = locale === "zh-Hant" ? "en" : "zh-Hant";

const PATHS: Record<Locale, string> = { "zh-Hant": "/contact/", en: "/en/contact/" };
const alternates: Record<Locale, string> = {
	"zh-Hant": new URL(PATHS["zh-Hant"], SITE).href,
	en: new URL(PATHS.en, SITE).href,
};

// 還沒開通的聯絡方式在 consts 裡是 "-"。有真值才做成可點的連結，
// 否則點下去會開出一個 tel:- 這種沒有意義的動作。
const hasPhone = COMPANY.phone !== "-";
const hasLine = COMPANY.lineId !== "-";
// tel: 只吃數字與 +，把排版用的分隔符去掉。
const telHref = `tel:${COMPANY.phone.replace(/[^\d+]/g, "")}`;
// 從個人檔案網址推回帳號，省得同一個字串在 consts 裡放兩份。
const instagramHandle = `@${SOCIAL.instagram.split("/").filter(Boolean).pop()}`;

const homeHref = locale === "en" ? "/en/" : "/";
const year = new Date().getFullYear();
---

<!doctype html>
<html lang={t(locale, "html.lang")}>
	<head>
		<BaseHead
			locale={locale}
			title={t(locale, "contact.meta.title")}
			description={t(locale, "contact.meta.description")}
			alternates={alternates}
		/>
	</head>
	<body>
		<MourningNotice locale={locale} />

		<header class="site-header">
			<div class="wrap">
				<a class="brand" href={homeHref}>
					<img class="brand-logo" src="/logo.png" alt={COMPANY.nameEn} width="583" height="86" />
				</a>

				<nav class="site-nav">
					<a href={PATHS[otherLocale]} aria-label={t(locale, "switch.aria")}>
						{t(locale, "switch.to")}
					</a>
					<ThemeToggle locale={locale} />
				</nav>
			</div>
		</header>

		<main class="wrap">
			<h1 class="title">{t(locale, "contact.heading")}</h1>
			<p class="lead">{t(locale, "contact.lead")}</p>

			{/* 四種狀態都先渲染好再由 script 打開對應的那個。
			    比起用 JS 組字串，這樣文案仍然只有一份，也不會有版面跳動。 */}
			<div class="banners" aria-live="polite">
				<div class="banner banner-ok" data-status="sent" hidden>
					<strong>{t(locale, "contact.sent.title")}</strong>
					<span>{t(locale, "contact.sent.body")}</span>
				</div>
				<div class="banner banner-err" data-status="invalid" hidden>
					<span>{t(locale, "contact.error.invalid")}</span>
				</div>
				<div class="banner banner-err" data-status="captcha" hidden>
					<span>{t(locale, "contact.error.captcha")}</span>
				</div>
				<div class="banner banner-err" data-status="failed" hidden>
					<span>{t(locale, "contact.error.failed")}</span>
					<a href={`mailto:${COMPANY.email}`}>{t(locale, "contact.error.mailto")}</a>
				</div>
			</div>

			<div class="layout">
				<aside class="info">
					<h2 class="block-title">{t(locale, "contact.info.title")}</h2>

					<dl class="info-list">
						<div class="info-item">
							<dt>{t(locale, "contact.info.phone")}</dt>
							<dd>
								{
									hasPhone ? (
										<a href={telHref}>{COMPANY.phone}</a>
									) : (
										<span class="empty">
											{COMPANY.phone}
											<span class="sr-only">{t(locale, "contact.info.pending")}</span>
										</span>
									)
								}
							</dd>
						</div>

						<div class="info-item">
							<dt>{t(locale, "contact.info.email")}</dt>
							<dd><a href={`mailto:${COMPANY.email}`}>{COMPANY.email}</a></dd>
						</div>

						<div class="info-item">
							<dt>{t(locale, "contact.info.line")}</dt>
							<dd>
								{
									hasLine ? (
										<span>{COMPANY.lineId}</span>
									) : (
										<span class="empty">
											{COMPANY.lineId}
											<span class="sr-only">{t(locale, "contact.info.pending")}</span>
										</span>
									)
								}
							</dd>
						</div>

						<div class="info-item">
							<dt>{t(locale, "contact.info.instagram")}</dt>
							<dd>
								<a href={SOCIAL.instagram} rel="me noopener" target="_blank">{instagramHandle}</a>
							</dd>
						</div>

						<div class="info-item">
							<dt>{t(locale, "contact.info.reply")}</dt>
							<dd>{t(locale, "contact.info.replyValue")}</dd>
						</div>
					</dl>
				</aside>

				<form class="form" method="post" action="/api/contact">
					<h2 class="block-title">{t(locale, "contact.form.title")}</h2>

					<input type="hidden" name="locale" value={locale} />

					{/* 蜜罐。真人看不到也 tab 不到，填了就是機器人。
					    欄位名稱刻意避開表單真正使用的名字（company 已經是公司名稱了）。 */}
					<div class="hp" aria-hidden="true">
						<label for="website">Website</label>
						<input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
					</div>

					<div class="row">
						<div class="field">
							<label for="name">{t(locale, "contact.name")}</label>
							<input
								id="name"
								name="name"
								type="text"
								required
								maxlength="100"
								autocomplete="name"
								placeholder={t(locale, "contact.namePlaceholder")}
							/>
						</div>

						<div class="field">
							<label for="email">{t(locale, "contact.email")}</label>
							<input
								id="email"
								name="email"
								type="email"
								required
								maxlength="254"
								autocomplete="email"
								aria-describedby="email-hint"
								placeholder="you@example.com"
							/>
						</div>
					</div>

					<p id="email-hint" class="hint">{t(locale, "contact.emailHint")}</p>

					<div class="row">
						<div class="field">
							<label for="phone">
								{t(locale, "contact.phone")}
								<span class="optional">· {t(locale, "contact.optional")}</span>
							</label>
							<input
								id="phone"
								name="phone"
								type="tel"
								maxlength="40"
								autocomplete="tel"
								placeholder={t(locale, "contact.phonePlaceholder")}
							/>
						</div>

						<div class="field">
							<label for="company">
								{t(locale, "contact.company")}
								<span class="optional">· {t(locale, "contact.optional")}</span>
							</label>
							<input
								id="company"
								name="company"
								type="text"
								maxlength="120"
								autocomplete="organization"
								placeholder={t(locale, "contact.companyPlaceholder")}
							/>
						</div>
					</div>

					<div class="field">
						<label for="category">{t(locale, "contact.category")}</label>
						<div class="select-wrap">
							<select id="category" name="category" required>
								<option value="" disabled selected>
									{t(locale, "contact.categoryPlaceholder")}
								</option>
								{
									CONTACT_CATEGORIES.map((category) => (
										<option value={category}>{t(locale, `contact.category.${category}`)}</option>
									))
								}
							</select>
						</div>
					</div>

					<div class="field">
						<label for="message">{t(locale, "contact.message")}</label>
						<textarea
							id="message"
							name="message"
							required
							minlength="10"
							maxlength="5000"
							rows="7"
							placeholder={t(locale, "contact.messagePlaceholder")}></textarea>
					</div>

					<div class="cf-turnstile" data-sitekey={CONTACT.turnstileSiteKey}></div>

					<button class="btn btn-primary submit" type="submit">{t(locale, "contact.submit")}</button>

					<p class="hint">{t(locale, "contact.privacy")}</p>
				</form>
			</div>

			<p class="back">
				<a href={homeHref}>{t(locale, "contact.back")}</a>
			</p>
		</main>

		<footer class="site-footer">
			<div class="wrap">
				<p>© {year} {COMPANY.nameEn} · {t(locale, "rights")}</p>
				<p>{t(locale, "taxId")} {COMPANY.taxId}</p>
			</div>
		</footer>

		<script
			src="https://challenges.cloudflare.com/turnstile/v0/api.js"
			async
			defer
			is:inline></script>

		<script is:inline>
			(function () {
				// /api/contact 處理完會轉址回來帶上狀態。只認固定的幾個值，
				// 不把網址裡的字串放進畫面。
				var params = new URLSearchParams(location.search);
				var status = params.get("sent") === "1" ? "sent" : params.get("error");
				var allowed = ["sent", "invalid", "captcha", "failed"];
				if (allowed.indexOf(status) === -1) return;

				var banner = document.querySelector('[data-status="' + status + '"]');
				if (banner) banner.hidden = false;
				if (status === "sent") {
					var form = document.querySelector("form");
					if (form) form.reset();
				}
				// 把參數從網址上抹掉，重新整理就不會又看到同一條訊息。
				history.replaceState(null, "", location.pathname);
			})();
		</script>

		<style>
			main {
				padding-block: clamp(2rem, 6vw, 3.5rem) 2rem;
			}
			.title {
				font-size: clamp(2rem, 5.4vw, 3.2rem);
				line-height: 1.2;
			}
			.lead {
				margin-top: 0.9rem;
				/* 導言不跟著版面拉到最寬，長行很難讀。
				   用 em 而不是 ch：ch 以「0」的字寬為基準，中日韓字元約是它的兩倍，
				   60ch 對英文剛好，對中文只放得下三十個字，句尾會被擠到第二行。
				   44em 讓中文導言（36 字）穩定單行，英文也還在合理的行寬內。 */
				max-width: 44em;
				color: var(--fg-secondary);
				font-size: clamp(1rem, 2.2vw, 1.1rem);
			}

			.banners:not(:empty) {
				display: block;
			}
			.banner {
				display: flex;
				flex-wrap: wrap;
				gap: 0.35rem 0.6rem;
				align-items: baseline;
				max-width: 44em;
				margin-top: 1.5rem;
				padding: 0.9rem 1.1rem;
				border: 1px solid var(--rule);
				border-left: 3px solid var(--fg);
				border-radius: 2px;
			}
			/* display:flex 的優先權高過瀏覽器內建的 [hidden]{display:none}，
			   沒有這條的話四種狀態會同時出現在畫面上。 */
			.banner[hidden] {
				display: none;
			}
			/* 錯誤與強調色同色，所以絕不能只靠顏色：文字本身就說明了發生什麼事。 */
			.banner-err {
				border-left-color: var(--accent);
			}

			/* 左資訊、右表單，左窄右寬。窄螢幕收成一欄，資訊在上（DOM 順序即閱讀順序，
			   不用 order 去搬，免得鍵盤焦點順序跟畫面對不起來）。 */
			.layout {
				display: grid;
				gap: 2.5rem clamp(2rem, 6vw, 5rem);
				margin-top: 2.5rem;
				padding-top: 2.5rem;
				border-top: 1px solid var(--rule);
				align-items: start;
			}
			@media (min-width: 56rem) {
				/* 22rem 是讓電子郵件位址不被從中間斷行的下限。表單另外收窄，右邊留白。 */
				.layout {
					grid-template-columns: minmax(0, 22rem) minmax(0, 40em);
				}
			}
			.block-title {
				margin-bottom: 1.25rem;
				font-family: var(--font-body);
				font-size: 1.1rem;
				font-weight: 700;
				line-height: 1.5;
			}

			.info-list {
				margin: 0;
			}
			.info-item {
				padding-block: 0.8rem;
				border-top: 1px solid var(--rule);
			}
			.info-item:first-child {
				border-top: 0;
				padding-top: 0;
			}
			.info-item dt {
				color: var(--fg-secondary);
				font-size: 0.85rem;
			}
			.info-item dd {
				margin: 0.1rem 0 0;
				overflow-wrap: anywhere;
			}
			/* 還沒開通的欄位。視覺上淡化，但螢幕閱讀器仍會唸出 .sr-only 的說明。 */
			.empty {
				color: var(--fg-secondary);
			}

			.form {
				display: grid;
				gap: 1.15rem;
			}
			.form .block-title {
				margin-bottom: 0;
			}
			.row {
				display: grid;
				gap: 1.15rem;
			}
			@media (min-width: 34rem) {
				.row {
					grid-template-columns: repeat(2, minmax(0, 1fr));
				}
			}
			.field {
				display: grid;
				gap: 0.4rem;
				min-width: 0;
			}
			label {
				font-size: 0.9rem;
				font-weight: 700;
			}
			.optional {
				color: var(--fg-secondary);
				font-weight: 400;
			}
			input[type="text"],
			input[type="email"],
			input[type="tel"],
			select,
			textarea {
				width: 100%;
				padding: 0.7rem 0.85rem;
				border: 1px solid var(--fg-secondary);
				border-radius: 2px;
				background: var(--bg);
				color: var(--fg);
				font: inherit;
				font-size: 0.95rem;
			}
			input:hover,
			select:hover,
			textarea:hover {
				border-color: var(--fg);
			}
			input::placeholder,
			textarea::placeholder {
				color: var(--fg-secondary);
				opacity: 1;
			}

			.select-wrap {
				position: relative;
			}
			select {
				appearance: none;
				padding-right: 2.5rem;
				cursor: pointer;
			}
			/* 自繪箭頭，否則各家瀏覽器的原生箭頭在深色底上會看不見。
			   用邊框畫，不用漸層。 */
			.select-wrap::after {
				content: "";
				position: absolute;
				right: 1.1rem;
				top: 50%;
				width: 0.5rem;
				height: 0.5rem;
				border-right: 2px solid var(--fg-secondary);
				border-bottom: 2px solid var(--fg-secondary);
				transform: translateY(-70%) rotate(45deg);
				pointer-events: none;
			}
			/* 尚未選擇時，顯示文字比照 placeholder 淡化 */
			select:invalid {
				color: var(--fg-secondary);
			}

			/* 展開後的選項清單。原生 <option> 幾乎吃不到 CSS，要自訂面板只能靠
			   customizable select（appearance: base-select）。不支援的瀏覽器會
			   整段忽略 @supports，落回上面那組 appearance:none + 自繪箭頭。
			   外觀樸素但完全可用，而且元素始終是真正的 <select>，鍵盤操作、
			   表單驗證、行動裝置的原生選單都不受影響。 */
			@supports (appearance: base-select) {
				select,
				select::picker(select) {
					appearance: base-select;
				}
				select {
					/* 改用 ::picker-icon 畫箭頭，收回 fallback 的自繪箭頭與右內距。 */
					padding-right: 0.85rem;
					display: flex;
					align-items: center;
					justify-content: space-between;
					gap: 0.5rem;
				}
				.select-wrap::after {
					display: none;
				}
				select::picker-icon {
					color: var(--fg-secondary);
				}

				select::picker(select) {
					border: 1px solid var(--fg);
					border-radius: 2px;
					/* 面板要不透明，透明的話底下的文字會透出來。 */
					background: var(--bg);
					padding: 0.25rem;
					/* 類別多的時候不要把面板拉到整個視窗高。 */
					max-height: 20rem;
					overflow-y: auto;
				}

				option {
					position: relative;
					display: flex;
					align-items: center;
					/* 左側留出打勾的欄位，未選中的列才不會跟選中的列對不齊。 */
					padding: 0.6rem 1rem 0.6rem 2.1rem;
					border-radius: 2px;
					color: var(--fg);
					font-size: 0.95rem;
					line-height: 1.4;
					cursor: pointer;
				}
				option:hover,
				option:focus {
					background: var(--hover);
				}
				/* placeholder 雖然也是 :checked，但它不是一個「選擇」，不該被強調。 */
				option:checked:not([value=""]) {
					font-weight: 700;
				}
				/* 打勾記號不是內文字級的文字，用強調色不受內文對比度門檻限制。 */
				option::checkmark {
					position: absolute;
					left: 0.75rem;
					color: var(--accent);
				}
				/* placeholder 那一列比照收合狀態淡化，跟真正的選項區分開。 */
				option[value=""] {
					color: var(--fg-secondary);
				}
			}

			textarea {
				resize: vertical;
				min-height: 8rem;
			}
			/* 只在使用者動過之後才標記，一進頁面就滿版警示很勸退。
			   強調色與錯誤同色，所以不只換顏色，邊框也加粗成 2px（內距同步減 1px 免得欄位跳動）。 */
			input:user-invalid,
			select:user-invalid,
			textarea:user-invalid {
				padding: calc(0.7rem - 1px) calc(0.85rem - 1px);
				border-width: 2px;
				border-color: var(--accent);
			}
			.hint {
				color: var(--fg-secondary);
				font-size: 0.85rem;
				line-height: 1.6;
			}

			/* 蜜罐。不用 display:none，有些機器人會跳過被隱藏的欄位。 */
			.hp {
				position: absolute;
				left: -9999px;
				width: 1px;
				height: 1px;
				overflow: hidden;
			}

			.submit {
				justify-self: start;
			}

			.back {
				margin-top: 2.5rem;
				font-size: 0.9rem;
			}

			.site-footer p {
				margin: 0;
			}

			@media (max-width: 30rem) {
				.brand-logo {
					height: 24px;
				}
				.submit {
					justify-self: stretch;
					justify-content: center;
				}
			}
		</style>
	</body>
</html>
