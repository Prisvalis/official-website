---
import BaseHead from "../components/BaseHead.astro";
import { COMPANY, SOCIAL, LOCALE_HOME_PATH, type Locale } from "../consts";
import { t } from "../i18n/ui";

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const htmlLang = t(locale, "html.lang");
const otherLocale: Locale = locale === "zh-Hant" ? "en" : "zh-Hant";
// 相對路徑：切換語言時留在訪客當下的網域，不要跳回 SITE。
const switchHref = LOCALE_HOME_PATH[otherLocale];

const year = new Date().getFullYear();
---

<!doctype html>
<html lang={htmlLang}>
	<head>
		<BaseHead locale={locale} />
	</head>
	<body>
		<div class="glow" aria-hidden="true"></div>
		<div class="grid" aria-hidden="true"></div>

		<div class="page">
			<header class="topbar">
				<a class="brand" href={LOCALE_HOME_PATH[locale]}>
					<img
						class="brand-logo"
						src="/logo.png"
						alt={COMPANY.nameEn}
						width="583"
						height="86"
					/>
				</a>

				<nav class="controls">
					<a class="control lang" href={switchHref} aria-label={t(locale, "switch.aria")}>
						{t(locale, "switch.to")}
					</a>
					<button
						id="theme-toggle"
						class="control icon-btn"
						type="button"
						aria-label={t(locale, "theme.aria")}
						title={t(locale, "theme.aria")}
					>
						<svg class="icon sun" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
							<circle cx="12" cy="12" r="4.2" fill="currentColor"></circle>
							<g stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
								<line x1="12" y1="2.5" x2="12" y2="5"></line>
								<line x1="12" y1="19" x2="12" y2="21.5"></line>
								<line x1="2.5" y1="12" x2="5" y2="12"></line>
								<line x1="19" y1="12" x2="21.5" y2="12"></line>
								<line x1="5.2" y1="5.2" x2="6.9" y2="6.9"></line>
								<line x1="17.1" y1="17.1" x2="18.8" y2="18.8"></line>
								<line x1="18.8" y1="5.2" x2="17.1" y2="6.9"></line>
								<line x1="6.9" y1="17.1" x2="5.2" y2="18.8"></line>
							</g>
						</svg>
						<svg class="icon moon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
							<path
								fill="currentColor"
								d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
						</svg>
					</button>
				</nav>
			</header>

			<main class="hero">
				<span class="badge">
					<span class="dot" aria-hidden="true"></span>
					{t(locale, "badge")}
				</span>

				<h1 class="title">{t(locale, "heading")}</h1>

				<p class="company">
					<span class="company-primary">
						{locale === "zh-Hant" ? COMPANY.nameZh : COMPANY.nameEn}
					</span>
					<span class="company-secondary">
						{locale === "zh-Hant" ? COMPANY.nameEn : COMPANY.nameZh}
					</span>
				</p>

				<p class="subheading">{t(locale, "subheading")}</p>

				<a class="cta" href={locale === "en" ? "/en/contact/" : "/contact/"}>
					{t(locale, "contact")}
					<span aria-hidden="true">→</span>
				</a>
			</main>

			<footer class="site-footer">
				<div class="social">
					<a
						class="social-link"
						href={SOCIAL.instagram}
						target="_blank"
						rel="me noopener noreferrer"
						aria-label={`${COMPANY.shortEn} · Instagram`}
					>
						<svg
							viewBox="0 0 24 24"
							width="20"
							height="20"
							aria-hidden="true"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
						>
							<rect x="2.5" y="2.5" width="19" height="19" rx="5.5"></rect>
							<circle cx="12" cy="12" r="4.2"></circle>
							<circle cx="17.4" cy="6.6" r="1.15" fill="currentColor" stroke="none"></circle>
						</svg>
					</a>
					<a
						class="social-link"
						href={SOCIAL.threads}
						target="_blank"
						rel="me noopener noreferrer"
						aria-label={`${COMPANY.shortEn} · Threads`}
					>
						<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
							<path
								fill="currentColor"
								d="M12.186 24h-.007c-3.581-.024-6.334-1.205-8.184-3.509C2.35 18.44 1.5 15.586 1.472 12.01v-.017c.03-3.579.879-6.43 2.525-8.482C5.845 1.205 8.6.024 12.18 0h.014c2.746.02 5.043.725 6.826 2.098 1.677 1.29 2.858 3.13 3.509 5.467l-2.04.569c-1.104-3.96-3.898-5.984-8.304-6.015-2.91.022-5.11.936-6.54 2.717C4.307 6.504 3.616 8.914 3.589 12c.027 3.086.718 5.496 2.057 7.166 1.43 1.781 3.63 2.695 6.54 2.717 2.623-.02 4.354-.634 5.798-2.05 1.658-1.626 1.629-3.626 1.116-4.83-.298-.7-.847-1.281-1.591-1.711-.187 1.318-.593 2.362-1.214 3.115-.83 1.006-2.008 1.557-3.501 1.635-1.128.059-2.212-.208-3.053-.752-.994-.643-1.574-1.626-1.634-2.766-.059-1.115.379-2.14 1.234-2.887.821-.717 1.98-1.137 3.44-1.25a13.87 13.87 0 0 1 2.982.126c-.132-.79-.399-1.407-.795-1.844-.535-.591-1.362-.892-2.459-.899h-.034c-.882 0-2.077.243-2.838 1.383l-1.68-1.13c1.019-1.51 2.674-2.341 4.659-2.341h.052c3.316.021 5.293 2.049 5.485 5.538.11.045.216.093.32.144 1.469.69 2.545 1.735 3.109 3.024.786 1.797.833 4.726-1.485 6.998-1.771 1.737-3.921 2.521-6.849 2.521z"
							></path>
						</svg>
					</a>
				</div>
				<p class="copyright">© {year} {COMPANY.nameEn} · {t(locale, "rights")}</p>
				<p class="copyright">{t(locale, "taxId")} {COMPANY.taxId}</p>
			</footer>
		</div>

		<script is:inline>
			(function () {
				var btn = document.getElementById("theme-toggle");
				if (!btn) return;
				btn.addEventListener("click", function () {
					var root = document.documentElement;
					var next = root.dataset.theme === "dark" ? "light" : "dark";
					root.dataset.theme = next;
					try {
						localStorage.setItem("theme", next);
					} catch (e) {}
				});
			})();
		</script>

		<style>
			.page {
				position: relative;
				z-index: 1;
				min-height: 100svh;
				max-width: 1120px;
				margin: 0 auto;
				padding: clamp(1.25rem, 3vw, 2.25rem);
				display: flex;
				flex-direction: column;
			}

			/* Background layers */
			.glow {
				position: fixed;
				inset: 0;
				z-index: 0;
				background:
					radial-gradient(60% 55% at 50% 0%, var(--glow-1), transparent 70%),
					radial-gradient(45% 45% at 85% 25%, var(--glow-2), transparent 70%);
				pointer-events: none;
			}
			.grid {
				position: fixed;
				inset: 0;
				z-index: 0;
				background-image:
					linear-gradient(to right, var(--grid) 1px, transparent 1px),
					linear-gradient(to bottom, var(--grid) 1px, transparent 1px);
				background-size: 48px 48px;
				mask-image: radial-gradient(70% 60% at 50% 40%, #000 40%, transparent 100%);
				-webkit-mask-image: radial-gradient(70% 60% at 50% 40%, #000 40%, transparent 100%);
				pointer-events: none;
			}

			/* Top bar */
			.topbar {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 1rem;
			}
			.brand {
				display: inline-flex;
				align-items: center;
			}
			.brand-logo {
				display: block;
				height: 28px;
				width: auto;
			}

			.controls {
				display: flex;
				align-items: center;
				gap: 0.5rem;
			}
			.control {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				height: 40px;
				padding: 0 0.9rem;
				border: 1px solid var(--border);
				border-radius: 10px;
				background: var(--surface);
				color: var(--text);
				font-size: 0.9rem;
				font-weight: 500;
				backdrop-filter: blur(8px);
				cursor: pointer;
				transition: border-color 0.2s ease, transform 0.15s ease, background 0.2s ease;
			}
			.control:hover {
				border-color: var(--accent);
				transform: translateY(-1px);
			}
			.icon-btn {
				width: 40px;
				padding: 0;
			}
			.icon {
				display: block;
			}
			:root[data-theme="dark"] .sun {
				display: none;
			}
			:root:not([data-theme="dark"]) .moon {
				display: none;
			}

			/* Hero */
			.hero {
				flex: 1;
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				text-align: center;
				padding: 3rem 0;
			}
			.badge {
				display: inline-flex;
				align-items: center;
				gap: 0.5rem;
				padding: 0.4rem 0.9rem;
				border: 1px solid var(--border);
				border-radius: 999px;
				background: var(--surface);
				color: var(--text-muted);
				font-size: 0.85rem;
				backdrop-filter: blur(8px);
			}
			.dot {
				width: 8px;
				height: 8px;
				border-radius: 50%;
				background: var(--accent);
				box-shadow: 0 0 0 0 var(--accent);
				animation: pulse 2s infinite;
			}
			@keyframes pulse {
				0% {
					box-shadow: 0 0 0 0 var(--glow-1);
				}
				70% {
					box-shadow: 0 0 0 10px transparent;
				}
				100% {
					box-shadow: 0 0 0 0 transparent;
				}
			}

			.title {
				margin: 1.4rem 0 0;
				/* Extra room so gradient-clipped descenders (g, y, p) aren't cut off */
				padding-bottom: 0.12em;
				font-size: clamp(2.75rem, 9vw, 6rem);
				line-height: 1.12;
				letter-spacing: -0.03em;
				font-weight: 800;
				background: linear-gradient(180deg, var(--text), var(--text-muted));
				-webkit-background-clip: text;
				background-clip: text;
				color: transparent;
			}

			.company {
				margin: 1.6rem 0 0;
				display: flex;
				flex-direction: column;
				gap: 0.25rem;
			}
			.company-primary {
				font-size: clamp(1.25rem, 3.5vw, 1.9rem);
				font-weight: 700;
				color: var(--text);
			}
			.company-secondary {
				font-size: clamp(0.9rem, 2.2vw, 1.1rem);
				color: var(--text-muted);
				letter-spacing: 0.02em;
			}

			.subheading {
				margin: 1.4rem auto 0;
				max-width: 34rem;
				color: var(--text-muted);
				font-size: clamp(1rem, 2.2vw, 1.15rem);
			}

			.cta {
				margin-top: 2.2rem;
				display: inline-flex;
				align-items: center;
				gap: 0.5rem;
				padding: 0.85rem 1.5rem;
				border-radius: 12px;
				color: #fff;
				font-weight: 600;
				background: linear-gradient(135deg, var(--accent), var(--accent-2));
				box-shadow: var(--shadow);
				transition: transform 0.15s ease, box-shadow 0.2s ease;
			}
			.cta:hover {
				transform: translateY(-2px);
			}
			.cta span {
				transition: transform 0.15s ease;
			}
			.cta:hover span {
				transform: translateX(3px);
			}

			.site-footer {
				text-align: center;
				padding-top: 2rem;
			}
			.social {
				display: flex;
				justify-content: center;
				gap: 0.6rem;
				margin-bottom: 1rem;
			}
			.social-link {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				width: 40px;
				height: 40px;
				border: 1px solid var(--border);
				border-radius: 10px;
				background: var(--surface);
				color: var(--text-muted);
				backdrop-filter: blur(8px);
				transition: color 0.2s ease, border-color 0.2s ease, transform 0.15s ease;
			}
			.social-link:hover {
				color: var(--text);
				border-color: var(--accent);
				transform: translateY(-1px);
			}
			.copyright {
				margin: 0;
				color: var(--text-muted);
				font-size: 0.85rem;
			}

			@media (max-width: 480px) {
				.brand-logo {
					height: 24px;
				}
			}
		</style>
	</body>
</html>
