---
// Company of One 產品頁（/CoO 與 /en/CoO）的外框。
//
// 仍然自己出 head，不用官網的 BaseHead：canonical 由路由自己算（帶不帶尾斜線
// 會產出兩種值），而且這幾頁沒有 Organization 的結構化資料。
// 樣式則與官網共用 global.css 的 token，coo.css 只放產品頁自己的版面。
// 華國美學版：頁首、主選單、跑馬燈、側欄與頁尾都由 PortalShell 提供，
// 產品頁原本的頁尾連結群組放進外框頁尾的 footer slot。
import "../styles/global.css";
import "../styles/coo.css";
import Fonts from "../components/Fonts.astro";
import PortalShell from "../components/PortalShell.astro";
import ThemeInit from "../components/ThemeInit.astro";
import { portal } from "../i18n/portal";
import { SITE, COMPANY, type Locale } from "../consts";
import { t } from "../i18n/ui";
import { coo, cooUrl, cooPageUrl, APP_URL, REPO_URL, COO_NAME, type CooPage } from "../i18n/coo";

interface Props {
	locale: Locale;
	page: CooPage;
}

const { locale, page } = Astro.props;
const c = coo[locale];
const meta = c.meta[page];

const pageTitle = meta.title ? `${meta.title}｜${COO_NAME}` : `${COO_NAME}｜${c.tagline}`;

// canonical 不用 Astro.url：帶不帶尾斜線會產出兩種值，指向同一個頁面。
// 由路由自己算，順便讓 hreflang 一定對得上。
const canonical = new URL(cooPageUrl(locale, page), SITE).href;
const zhHref = new URL(cooPageUrl("zh-Hant", page), SITE).href;
const enHref = new URL(cooPageUrl("en", page), SITE).href;
const otherLocale: Locale = locale === "zh-Hant" ? "en" : "zh-Hant";

const p = portal[locale];
const portalPage = page === "home" ? "coo" : page;
const crumbs =
	page === "home"
		? [{ label: p.crumbs.coo }]
		: [{ label: p.crumbs.coo, href: cooUrl(locale, "/") }, { label: p.crumbs[page] }];

const footerGroups = [
	{
		title: c.footer.product,
		links: [
			{ href: cooUrl(locale, "/features"), label: c.footer.featuresAll },
			{ href: cooUrl(locale, "/pricing"), label: c.footer.pricingAll },
			{ href: cooUrl(locale, "/features#security"), label: c.footer.security },
		],
	},
	{
		title: c.footer.resources,
		links: [
			{ href: REPO_URL, label: c.footer.repo },
			{ href: `${REPO_URL}/blob/main/docs/schema.md`, label: c.footer.schema },
			{ href: `${REPO_URL}/issues`, label: c.footer.issues },
		],
	},
	{
		title: c.footer.begin,
		links: [{ href: APP_URL, label: c.footer.signin }],
	},
];
---

<!doctype html>
<html lang={t(locale, "html.lang")}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{pageTitle}</title>
		<meta name="description" content={meta.description} />
		<meta name="generator" content={Astro.generator} />
		<meta name="google" content="notranslate" />
		<meta name="theme-color" media="(prefers-color-scheme: light)" content="#000095" />
		<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#000095" />

		<link rel="canonical" href={canonical} />
		<link rel="alternate" hreflang="zh-Hant" href={zhHref} />
		<link rel="alternate" hreflang="en" href={enHref} />
		<link rel="alternate" hreflang="x-default" href={zhHref} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={COMPANY.nameEn} />
		<meta property="og:locale" content={t(locale, "og.locale")} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={meta.description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={new URL("/og.svg", SITE).href} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={meta.description} />
		<meta name="twitter:image" content={new URL("/og.svg", SITE).href} />

		<Fonts />

		<!-- 與官網同一套：繪製前決定主題與追悼日，避免深淺色或彩色閃一下 -->
		<ThemeInit />
	</head>
	<body>
		<PortalShell locale={locale} page={portalPage} switchHref={cooPageUrl(otherLocale, page)} crumbs={crumbs}>
			<slot />

			<div class="coo-footer" slot="footer">
				<p>{COO_NAME}{c.colon}{c.footer.blurb}</p>
				<dl class="footer-rows">
					{
						footerGroups.map((group) => (
							<div>
								<dt>{group.title}</dt>
								<dd>
									<ul>
										{group.links.map((link) => (
											<li>
												<a href={link.href}>{link.label}</a>
											</li>
										))}
									</ul>
								</dd>
							</div>
						))
					}
				</dl>
				<p class="footer-fine">※ {c.footer.note}</p>
			</div>
		</PortalShell>
	</body>
</html>
