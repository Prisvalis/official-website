---
// Company of One 產品頁（/CoO 與 /en/CoO）的外框。
//
// 刻意不用官網的 BaseHead：那份會載入 global.css，而產品頁有自己的一套
// 同名 CSS 變數（--bg / --text / --accent…），兩份同時載入會互相蓋掉。
// 這裡自己出 head，換來的是 /CoO 完全自足，改它不會動到首頁。
import "../styles/coo.css";
import { SITE, COMPANY, type Locale } from "../consts";
import { t } from "../i18n/ui";
import { coo, cooUrl, cooPageUrl, APP_URL, REPO_URL, COO_NAME, type CooPage } from "../i18n/coo";

interface Props {
	locale: Locale;
	page: CooPage;
}

const { locale, page } = Astro.props;
const c = coo[locale];
const meta = c.meta[page];

const pageTitle = meta.title ? `${meta.title} — ${COO_NAME}` : `${COO_NAME} — ${c.tagline}`;

// canonical 不用 Astro.url：帶不帶尾斜線會產出兩種值，指向同一個頁面。
// 由路由自己算，順便讓 hreflang 一定對得上。
const canonical = new URL(cooPageUrl(locale, page), SITE).href;
const zhHref = new URL(cooPageUrl("zh-Hant", page), SITE).href;
const enHref = new URL(cooPageUrl("en", page), SITE).href;
const otherLocale: Locale = locale === "zh-Hant" ? "en" : "zh-Hant";

const nav = [
	{ href: cooUrl(locale, "/"), label: c.nav.home, key: "home" },
	{ href: cooUrl(locale, "/features"), label: c.nav.features, key: "features" },
	{ href: cooUrl(locale, "/pricing"), label: c.nav.pricing, key: "pricing" },
];
---

<!doctype html>
<html lang={t(locale, "html.lang")}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{pageTitle}</title>
		<meta name="description" content={meta.description} />
		<meta name="generator" content={Astro.generator} />
		<meta name="google" content="notranslate" />
		<meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff" />
		<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#12161b" />

		<link rel="canonical" href={canonical} />
		<link rel="alternate" hreflang="zh-Hant" href={zhHref} />
		<link rel="alternate" hreflang="en" href={enHref} />
		<link rel="alternate" hreflang="x-default" href={zhHref} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={COMPANY.nameEn} />
		<meta property="og:locale" content={t(locale, "og.locale")} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={meta.description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={new URL("/og.svg", SITE).href} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={meta.description} />
		<meta name="twitter:image" content={new URL("/og.svg", SITE).href} />

		<!-- 與官網同一套：繪製前決定主題，避免深淺色閃一下 -->
		<script is:inline>
			(function () {
				try {
					var stored = localStorage.getItem("theme");
					var theme =
						stored ||
						(window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
					document.documentElement.dataset.theme = theme;
				} catch (e) {
					document.documentElement.dataset.theme = "light";
				}
			})();
		</script>
	</head>
	<body>
		<a class="skip-link" href="#main">{c.skip}</a>

		<header class="site-header">
			<div class="wrap">
				<a class="brand" href={cooUrl(locale, "/")}>
					<span class="brand-mark" aria-hidden="true">1</span>
					{COO_NAME}
				</a>
				<nav class="site-nav" aria-label={c.navAria}>
					{
						nav.map((item) => (
							<a href={item.href} aria-current={page === item.key ? "page" : undefined}>
								{item.label}
							</a>
						))
					}
					<a href={cooPageUrl(otherLocale, page)} aria-label={t(locale, "switch.aria")}>
						{t(locale, "switch.to")}
					</a>
					<button
						id="theme-toggle"
						class="theme-btn"
						type="button"
						aria-label={t(locale, "theme.aria")}
						title={t(locale, "theme.aria")}
					>
						<svg class="icon sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
							<circle cx="12" cy="12" r="4.2" fill="currentColor"></circle>
							<g stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
								<line x1="12" y1="2.5" x2="12" y2="5"></line>
								<line x1="12" y1="19" x2="12" y2="21.5"></line>
								<line x1="2.5" y1="12" x2="5" y2="12"></line>
								<line x1="19" y1="12" x2="21.5" y2="12"></line>
								<line x1="5.2" y1="5.2" x2="6.9" y2="6.9"></line>
								<line x1="17.1" y1="17.1" x2="18.8" y2="18.8"></line>
								<line x1="18.8" y1="5.2" x2="17.1" y2="6.9"></line>
								<line x1="6.9" y1="17.1" x2="5.2" y2="18.8"></line>
							</g>
						</svg>
						<svg class="icon moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
							<path fill="currentColor" d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
						</svg>
					</button>
					<a class="btn" href={APP_URL}>{c.start}</a>
				</nav>
			</div>
		</header>

		<main id="main" tabindex="-1">
			<slot />
		</main>

		<footer class="site-footer">
			<div class="wrap">
				<div class="footer-grid">
					<div>
						<a class="brand" href={cooUrl(locale, "/")}>
							<span class="brand-mark" aria-hidden="true">1</span>
							{COO_NAME}
						</a>
						<p class="small" style="margin-top:.6rem">{c.footer.blurb}</p>
					</div>
					<div>
						<h3>{c.footer.product}</h3>
						<ul>
							<li><a href={cooUrl(locale, "/features")}>{c.footer.featuresAll}</a></li>
							<li><a href={cooUrl(locale, "/pricing")}>{c.footer.pricingAll}</a></li>
							<li><a href={cooUrl(locale, "/features#security")}>{c.footer.security}</a></li>
						</ul>
					</div>
					<div>
						<h3>{c.footer.resources}</h3>
						<ul>
							<li><a href={REPO_URL}>{c.footer.repo}</a></li>
							<li><a href={`${REPO_URL}/blob/main/docs/schema.md`}>{c.footer.schema}</a></li>
							<li><a href={`${REPO_URL}/issues`}>{c.footer.issues}</a></li>
						</ul>
					</div>
					<div>
						<h3>{c.footer.begin}</h3>
						<ul>
							<li><a href={APP_URL}>{c.footer.signin}</a></li>
						</ul>
					</div>
				</div>
				<div class="footer-bottom small">
					<p>{COO_NAME} · {c.footer.note}</p>
					<p>© {new Date().getFullYear()} {COMPANY.nameEn} · {t(locale, "rights")}</p>
				</div>
			</div>
		</footer>

		<script is:inline>
			(function () {
				var btn = document.getElementById("theme-toggle");
				if (!btn) return;
				btn.addEventListener("click", function () {
					var root = document.documentElement;
					var next = root.dataset.theme === "dark" ? "light" : "dark";
					root.dataset.theme = next;
					try {
						localStorage.setItem("theme", next);
					} catch (e) {}
				});
			})();
		</script>
	</body>
</html>
