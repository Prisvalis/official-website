---
// Company of One 產品頁（/CoO 與 /en/CoO）的外框。
//
// 仍然自己出 head，不用官網的 BaseHead：canonical 由路由自己算（帶不帶尾斜線
// 會產出兩種值），而且這幾頁沒有 Organization 的結構化資料。
// 樣式則與官網共用 global.css 的 token，coo.css 只放產品頁自己的版面。
import "../styles/global.css";
import "../styles/coo.css";
import Fonts from "../components/Fonts.astro";
import MourningNotice from "../components/MourningNotice.astro";
import ThemeInit from "../components/ThemeInit.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import { SITE, COMPANY, type Locale } from "../consts";
import { t } from "../i18n/ui";
import { coo, cooUrl, cooPageUrl, APP_URL, REPO_URL, COO_NAME, type CooPage } from "../i18n/coo";

interface Props {
	locale: Locale;
	page: CooPage;
}

const { locale, page } = Astro.props;
const c = coo[locale];
const meta = c.meta[page];

const pageTitle = meta.title ? `${meta.title}｜${COO_NAME}` : `${COO_NAME}｜${c.tagline}`;

// canonical 不用 Astro.url：帶不帶尾斜線會產出兩種值，指向同一個頁面。
// 由路由自己算，順便讓 hreflang 一定對得上。
const canonical = new URL(cooPageUrl(locale, page), SITE).href;
const zhHref = new URL(cooPageUrl("zh-Hant", page), SITE).href;
const enHref = new URL(cooPageUrl("en", page), SITE).href;
const otherLocale: Locale = locale === "zh-Hant" ? "en" : "zh-Hant";

const nav = [
	{ href: cooUrl(locale, "/"), label: c.nav.home, key: "home" },
	{ href: cooUrl(locale, "/features"), label: c.nav.features, key: "features" },
	{ href: cooUrl(locale, "/pricing"), label: c.nav.pricing, key: "pricing" },
];

const footerGroups = [
	{
		title: c.footer.product,
		links: [
			{ href: cooUrl(locale, "/features"), label: c.footer.featuresAll },
			{ href: cooUrl(locale, "/pricing"), label: c.footer.pricingAll },
			{ href: cooUrl(locale, "/features#security"), label: c.footer.security },
		],
	},
	{
		title: c.footer.resources,
		links: [
			{ href: REPO_URL, label: c.footer.repo },
			{ href: `${REPO_URL}/blob/main/docs/schema.md`, label: c.footer.schema },
			{ href: `${REPO_URL}/issues`, label: c.footer.issues },
		],
	},
	{
		title: c.footer.begin,
		links: [{ href: APP_URL, label: c.footer.signin }],
	},
];
---

<!doctype html>
<html lang={t(locale, "html.lang")}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{pageTitle}</title>
		<meta name="description" content={meta.description} />
		<meta name="generator" content={Astro.generator} />
		<meta name="google" content="notranslate" />
		<meta name="theme-color" media="(prefers-color-scheme: light)" content="#F4F1EA" />
		<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#1A1A1A" />

		<link rel="canonical" href={canonical} />
		<link rel="alternate" hreflang="zh-Hant" href={zhHref} />
		<link rel="alternate" hreflang="en" href={enHref} />
		<link rel="alternate" hreflang="x-default" href={zhHref} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={COMPANY.nameEn} />
		<meta property="og:locale" content={t(locale, "og.locale")} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={meta.description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={new URL("/og.svg", SITE).href} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={meta.description} />
		<meta name="twitter:image" content={new URL("/og.svg", SITE).href} />

		<Fonts />

		<!-- 與官網同一套：繪製前決定主題與追悼日，避免深淺色或彩色閃一下 -->
		<ThemeInit />
	</head>
	<body>
		<a class="skip-link" href="#main">{c.skip}</a>

		<MourningNotice locale={locale} />

		<header class="site-header">
			<div class="wrap">
				<a class="brand" href={cooUrl(locale, "/")}>
					<span class="brand-name">{COO_NAME}</span>
				</a>
				<nav class="site-nav" aria-label={c.navAria}>
					{
						nav.map((item) => (
							<a href={item.href} aria-current={page === item.key ? "page" : undefined}>
								{item.label}
							</a>
						))
					}
					<a href={cooPageUrl(otherLocale, page)} aria-label={t(locale, "switch.aria")}>
						{t(locale, "switch.to")}
					</a>
					<ThemeToggle locale={locale} />
					<a class="btn nav-cta" href={APP_URL}>{c.start}</a>
				</nav>
			</div>
		</header>

		<main id="main" tabindex="-1">
			<slot />
		</main>

		<footer class="site-footer">
			<div class="wrap">
				<p>{c.footer.blurb}</p>
				<dl class="footer-rows">
					{
						footerGroups.map((group) => (
							<div>
								<dt>{group.title}</dt>
								<dd>
									<ul>
										{group.links.map((link) => (
											<li>
												<a href={link.href}>{link.label}</a>
											</li>
										))}
									</ul>
								</dd>
							</div>
						))
					}
				</dl>
				<div class="footer-bottom">
					<p>{COO_NAME} · {c.footer.note}</p>
					<p>
						© {new Date().getFullYear()}
						{COMPANY.nameEn} · {t(locale, "rights")} · {t(locale, "taxId")}
						{COMPANY.taxId}
					</p>
				</div>
			</div>
		</footer>
	</body>
</html>
