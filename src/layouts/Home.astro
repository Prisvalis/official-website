---
// 首頁。文案全部在 src/i18n/home.ts，這裡只負責結構與版面。
//
// 版面依「華國美學」Skill：固定寬度的入口網站外框、三層頁首、左側欄重複導覽、
// 主欄是一格一格有標題列的框，作品用行政表格，限制用黃底公告。
// 共用樣式在 styles/global.css。
import BaseHead from "../components/BaseHead.astro";
import MourningNotice from "../components/MourningNotice.astro";
import PortalHeader from "../components/PortalHeader.astro";
import PortalFooter from "../components/PortalFooter.astro";
import WordArt from "../components/WordArt.astro";
import { COMPANY, LOCALE_HOME_PATH, type Locale } from "../consts";
import { t } from "../i18n/ui";
import { home } from "../i18n/home";
import { cooUrl, APP_URL, COO_NAME } from "../i18n/coo";

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const htmlLang = t(locale, "html.lang");
const otherLocale: Locale = locale === "zh-Hant" ? "en" : "zh-Hant";
// 相對路徑：切換語言時留在訪客當下的網域，不要跳回 SITE。
const switchHref = LOCALE_HOME_PATH[otherLocale];
const contactHref = locale === "en" ? "/en/contact/" : "/contact/";
const cooHref = cooUrl(locale, "/");
const statusHref = cooUrl(locale, "/#status");
const external = t(locale, "link.external");

const c = home[locale];

const sections = [
	{ id: "work", label: c.work.title },
	{ id: "process", label: c.process.title },
	{ id: "scope", label: c.scope.title },
	{ id: "contact", label: c.contact.title },
];

const nav = [
	...sections.slice(0, 3).map((s) => ({ href: `#${s.id}`, label: s.label })),
	{ href: cooHref, label: COO_NAME },
	{ href: contactHref, label: t(locale, "nav.contact") },
];
---

<!doctype html>
<html lang={htmlLang}>
	<head>
		<BaseHead locale={locale} />
	</head>
	<body>
		<MourningNotice locale={locale} />

		<div class="portal">
			<PortalHeader
				locale={locale}
				homeHref={LOCALE_HOME_PATH[locale]}
				name={COMPANY.nameZh}
				switchHref={switchHref}
				nav={nav}
			/>

			<div class="portal-body">
				<main class="portal-main">
					<section class="hero-box">
						<WordArt text={c.hero.h1} />
						<p class="hero-lead">{c.hero.lead}</p>
						<div class="actions">
							<a class="btn btn-primary" href={contactHref}>{c.hero.ctaPrimary}</a>
							<a class="btn" href={cooHref}>{c.hero.ctaSecondary}</a>
						</div>
					</section>

					<section class="box" id="work">
						<h2 class="box-title">{c.work.title}</h2>
						<div class="box-body">
							<p>{c.work.lead}</p>

							<div class="table-scroll">
								<table>
									<caption>{c.work.caption}</caption>
									<thead>
										<tr>
											<th scope="col">{c.work.columns.area}</th>
											<th scope="col">{c.work.columns.approach}</th>
											<th scope="col">{c.work.columns.reason}</th>
										</tr>
									</thead>
									<tbody>
										{
											c.work.rows.map((row) => (
												<tr>
													<th scope="row">{row.area}</th>
													<td>{row.approach}</td>
													<td>{row.reason}</td>
												</tr>
											))
										}
									</tbody>
								</table>
							</div>

							<div class="notice">
								<p>
									{c.work.limits}
									<a href={statusHref}>{c.work.links.status}</a>
								</p>
							</div>
						</div>
					</section>

					<section class="box" id="process">
						<h2 class="box-title">{c.process.title}</h2>
						<div class="box-body">
							<ol class="steps">
								{
									c.process.steps.map((step) => (
										<li>
											<h3>{step.title}</h3>
											<p>{step.body}</p>
										</li>
									))
								}
							</ol>
						</div>
					</section>

					<section class="box" id="scope">
						<h2 class="box-title">{c.scope.title}</h2>
						<div class="box-body scope">
							{c.scope.body.map((para) => <p>{para}</p>)}
						</div>
					</section>

					<section class="box" id="contact">
						<h2 class="box-title">{c.contact.title}</h2>
						<div class="box-body">
							<p>{c.contact.body}</p>
							<div class="actions">
								<a class="btn btn-primary" href={contactHref}>{c.contact.cta}</a>
								<span>
									{c.contact.email}
									<a href={`mailto:${COMPANY.email}`}>{COMPANY.email}</a>
								</span>
							</div>
						</div>
					</section>
				</main>

				<aside class="portal-side">
					<section class="side-box">
						<h2 class="side-box-title">{COMPANY.nameZh}</h2>
						<ul>
							{
								sections.map((s) => (
									<li>
										<a href={`#${s.id}`}>{s.label}</a>
									</li>
								))
							}
						</ul>
					</section>

					<section class="side-box">
						<h2 class="side-box-title">{COO_NAME}</h2>
						<ul>
							<li><a href={cooHref}>{c.work.links.product}</a></li>
							<li>
								<a href={APP_URL} target="_blank" rel="noopener noreferrer">
									{c.work.links.demo}
									<svg
										class="ext"
										viewBox="0 0 24 24"
										width="12"
										height="12"
										aria-hidden="true"
										fill="none"
										stroke="currentColor"
										stroke-width="2.4"
										stroke-linecap="round"
										stroke-linejoin="round"><path d="M7 17 17 7M8 7h9v9"></path></svg
									>
									<span class="sr-only">{external}</span>
								</a>
							</li>
							<li><a href={statusHref}>{c.work.links.status}</a></li>
						</ul>
					</section>

					<section class="side-box">
						<h2 class="side-box-title">{c.contact.title}</h2>
						<p>
							<a href={contactHref}>{c.contact.cta}</a><br />
							<a href={`mailto:${COMPANY.email}`}>{COMPANY.email}</a>
						</p>
					</section>
				</aside>
			</div>

			<PortalFooter locale={locale} social />
		</div>

		<style>
			/* 首頁大框：金色雙線框、淡藍底，像簡報封面。 */
			.hero-box {
				position: relative;
				overflow: hidden;
				padding: 14.6px 16.2px 16px 15px;
				border: 3px double #b8860b;
				background: hsl(220 60% 97%);
			}
			:global(:root[data-theme="dark"]) .hero-box {
				border-color: #e0b43a;
				background: hsl(228 42% 14%);
			}
			.hero-lead {
				position: relative;
				margin-top: 12.4px;
				max-width: 42em;
				font-size: 15.6px;
				line-height: 1.75;
			}
			.actions {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				gap: 8px 13px;
				margin-top: 13.6px;
			}

			.table-scroll {
				position: relative;
				overflow-x: auto;
			}
			.table-scroll table {
				min-width: 30em;
			}

			/* 合作方式：一列一格的表格式清單，紅色編號。 */
			.steps {
				margin: 0;
				padding: 0;
				list-style: none;
				counter-reset: step;
				border: 1px solid var(--border);
			}
			.steps li {
				counter-increment: step;
				display: grid;
				grid-template-columns: 2.6em minmax(0, 1fr);
				gap: 1px 8px;
				padding: 6.8px 9px 7.2px 6px;
				border-top: 1px solid var(--border);
			}
			.steps li:first-child {
				border-top: 0;
			}
			.steps li:nth-child(odd) {
				background: var(--panel-alt);
			}
			.steps li::before {
				content: counter(step, decimal-leading-zero) / "";
				grid-row: span 2;
				color: var(--red);
				font-family: Arial, sans-serif;
				font-size: 20px;
				font-weight: bold;
				font-style: italic;
				line-height: 1.1;
				text-align: center;
				transform: translateY(0.6px);
			}
			.steps h3 {
				color: var(--roc-blue);
			}
			:global(:root[data-theme="dark"]) .steps h3 {
				color: #ffe45c;
			}

			/* 承接範圍：三段各一條底色，第二段與第一段只差一點亮度。 */
			.scope p {
				padding: 5.4px 7px 6px 8.2px;
				border-left: 3px solid var(--blue);
				background: var(--panel-alt);
			}
			.scope p:nth-child(2) {
				background: var(--panel-alt-2);
				border-left-color: var(--red);
			}
		</style>
	</body>
</html>
