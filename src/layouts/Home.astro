---
// 首頁。文案全部在 src/i18n/home.ts，這裡只負責結構與版面。
//
// 設計依 docs/brand-spec.md（Vignelli／瑞士國際主義 recipe）。全頁嚴格對齊 12 欄網格：
// 每個區塊上方一條粗線、左上一個大號紅色編號、內容從第 3 欄開始；資訊一律用表格
// 或編號清單。整頁只有一條色條標題，放在承接範圍。
// 共用樣式在 styles/global.css，頁首與頁尾在 SiteHeader、SiteFooter。
import BaseHead from "../components/BaseHead.astro";
import MourningNotice from "../components/MourningNotice.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Phrase from "../components/Phrase.astro";
import { COMPANY, LOCALE_HOME_PATH, SOCIAL, type Locale } from "../consts";
import { t } from "../i18n/ui";
import { home } from "../i18n/home";
import { coo, cooUrl, APP_URL, COO_NAME } from "../i18n/coo";
import { about, ABOUT_PATH } from "../i18n/about";

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const htmlLang = t(locale, "html.lang");
const otherLocale: Locale = locale === "zh-Hant" ? "en" : "zh-Hant";
// 相對路徑：切換語言時留在訪客當下的網域，不要跳回 SITE。
const switchHref = LOCALE_HOME_PATH[otherLocale];
const contactHref = locale === "en" ? "/en/contact/" : "/contact/";
const hasPhone = COMPANY.phone !== "-";
const hasLine = COMPANY.lineId !== "-";
const telHref = `tel:${COMPANY.phone.replace(/[^\d+]/g, "")}`;
const lineHref = COMPANY.lineUrl;
const instagramHandle = `@${SOCIAL.instagram.split("/").filter(Boolean).pop()}`;
const cooHref = cooUrl(locale, "/");
const statusHref = cooUrl(locale, "/#status");
const external = t(locale, "link.external");

const c = home[locale];
const a = about[locale];

// 開頭下方的公司資料，直接取自沿革頁的登記資料表（統一編號、公司所在地、核准設立日期），
// 不另外寫一份。沿革頁的表格順序改了，這裡的索引要跟著改。
const facts = [0, 7, 9].map((i) => a.profile.rows[i]);

const sections = [
	{ id: "work", label: c.work.title },
	{ id: "process", label: c.process.title },
	{ id: "scope", label: c.scope.title },
	{ id: "contact", label: c.contact.title },
];

const nav = [
	...sections.slice(0, 3).map((s) => ({ href: `#${s.id}`, label: s.label })),
	{ href: ABOUT_PATH[locale], label: a.navLabel },
	{ href: cooHref, label: COO_NAME },
	{ href: contactHref, label: t(locale, "nav.contact") },
];

const no = (i: number) => String(i).padStart(2, "0");
---

<!doctype html>
<html lang={htmlLang}>
	<head>
		<BaseHead locale={locale} />
	</head>
	<body>
		<MourningNotice locale={locale} />
		<SiteHeader locale={locale} homeHref={LOCALE_HOME_PATH[locale]} switchHref={switchHref} nav={nav} />

		<main id="main">
			<section class="hero">
				<div class="wrap grid">
					<h1 class="hero-title"><Phrase text={c.hero.h1} /></h1>
					<p class="lead measure hero-lead">{c.hero.lead}</p>
					<div class="actions hero-lead">
						<a class="btn btn-primary" href={contactHref}>{c.hero.ctaPrimary}</a>
						<a class="btn" href={cooHref}>{c.hero.ctaSecondary}</a>
					</div>

					<dl class="facts" aria-label={a.profile.title}>
						{
							facts.map((f) => (
								<div>
									<dt>{f.label}</dt>
									<dd>{f.value}</dd>
								</div>
							))
						}
						<div>
							<dt>{a.navLabel}</dt>
							<dd><a href={ABOUT_PATH[locale]}>{a.profile.title}</a></dd>
						</div>
					</dl>
				</div>
			</section>

			<section class="section" id="work">
				<div class="wrap grid">
					<p class="section-no" aria-hidden="true">{no(1)}</p>
					<div class="section-body">
						<h2>{c.work.title}</h2>
						<p class="measure intro">{c.work.lead}</p>

						<div class="table-scroll">
							<table>
								<caption>{c.work.caption}</caption>
								<thead>
									<tr>
										<th scope="col">{c.work.columns.area}</th>
										<th scope="col">{c.work.columns.approach}</th>
										<th scope="col">{c.work.columns.reason}</th>
									</tr>
								</thead>
								<tbody>
									{
										c.work.rows.map((row) => (
											<tr>
												<th scope="row">{row.area}</th>
												<td>{row.approach}</td>
												<td>{row.reason}</td>
											</tr>
										))
									}
								</tbody>
							</table>
						</div>

						<div class="notice">
							<p>
								{c.work.limits}
								<a href={statusHref}>{c.work.links.status}</a>
							</p>
						</div>

						<ul class="work-links">
							<li><a href={cooHref}>{c.work.links.product}</a></li>
							<li>
								<a href={APP_URL} target="_blank" rel="noopener noreferrer">
									{c.work.links.demo}
									<svg
										class="ext"
										viewBox="0 0 24 24"
										width="12"
										height="12"
										aria-hidden="true"
										fill="none"
										stroke="currentColor"
										stroke-width="2.4"
										stroke-linecap="square"><path d="M7 17 17 7M8 7h9v9"></path></svg
									>
									<span class="sr-only">{external}</span>
								</a>
							</li>
						</ul>

						<!-- Company of One 的營運總覽，與 CoO 產品首頁開頭同一張截圖。 -->
						<img
							class="shot"
							src="/coo/dashboard-overview.png"
							alt={coo[locale].home.heroShotAlt}
							width="1374"
							height="470"
							loading="lazy"
							decoding="async"
						/>
					</div>
				</div>
			</section>

			<section class="section" id="process">
				<div class="wrap grid">
					<p class="section-no" aria-hidden="true">{no(2)}</p>
					<div class="section-body">
						<h2>{c.process.title}</h2>
						<ol class="steps">
							{
								c.process.steps.map((step, i) => (
									<li>
										<span class="step-no" aria-hidden="true">
											{no(i + 1)}
										</span>
										<h3>{step.title}</h3>
										<p>{step.body}</p>
									</li>
								))
							}
						</ol>
					</div>
				</div>
			</section>

			<section class="section" id="scope">
				<div class="wrap grid">
					<p class="section-no" aria-hidden="true">{no(3)}</p>
					<div class="section-body">
						<h2 class="bar-title">{c.scope.title}</h2>
						<div class="prose">
							{c.scope.body.map((para) => <p>{para}</p>)}
						</div>
					</div>
				</div>
			</section>

			<section class="section" id="contact">
				<div class="wrap grid">
					<p class="section-no" aria-hidden="true">{no(4)}</p>
					<div class="section-body">
						<h2>{c.contact.title}</h2>
						<p class="measure intro">{c.contact.body}</p>

						<table class="info">
							<tbody>
								<tr>
									<th scope="row">{t(locale, "contact.info.phone")}</th>
									<td>
										{
											hasPhone ? (
												<a href={telHref}>{COMPANY.phone}</a>
											) : (
												<span class="empty">
													{COMPANY.phone}
													<span class="sr-only">{t(locale, "contact.info.pending")}</span>
												</span>
											)
										}
									</td>
								</tr>
								<tr>
									<th scope="row">{t(locale, "contact.info.email")}</th>
									<td><a href={`mailto:${COMPANY.email}`}>{COMPANY.email}</a></td>
								</tr>
								<tr>
									<th scope="row">{t(locale, "contact.info.line")}</th>
									<td>
										{
											hasLine ? (
												<a href={lineHref} target="_blank" rel="noopener noreferrer">
													{COMPANY.lineId}
													<span class="sr-only">{external}</span>
												</a>
											) : (
												<span class="empty">
													{COMPANY.lineId}
													<span class="sr-only">{t(locale, "contact.info.pending")}</span>
												</span>
											)
										}
									</td>
								</tr>
								<tr>
									<th scope="row">{t(locale, "contact.info.instagram")}</th>
									<td>
										<a href={SOCIAL.instagram} target="_blank" rel="me noopener noreferrer">
											{instagramHandle}
											<span class="sr-only">{external}</span>
										</a>
									</td>
								</tr>
								<tr>
									<th scope="row">{t(locale, "contact.info.reply")}</th>
									<td>{t(locale, "contact.info.replyValue")}</td>
								</tr>
							</tbody>
						</table>

						<div class="actions">
							<a class="btn" href={`${contactHref}#form`}>{t(locale, "contact.form.title")}</a>
						</div>
					</div>
				</div>
			</section>
		</main>

		<SiteFooter
			locale={locale}
			links={[
				{ href: ABOUT_PATH[locale], label: a.navLabel },
				{ href: cooHref, label: COO_NAME },
				{ href: contactHref, label: t(locale, "nav.contact") },
			]}
		/>

		<style>
			/* --- 開頭：大標題占 10 欄，導言與按鈕從第 3 欄開始，下方一列公司資料 --- */
			.hero {
				padding-block: var(--s-6) var(--s-5);
			}
			@media (min-width: 760px) {
				.hero {
					padding-block: var(--s-7) var(--s-6);
				}
				.hero-title {
					grid-column: 1 / -1;
				}
			}
			.hero-lead {
				margin-top: var(--s-4);
			}

			/* 公司資料：四欄等寬，上方細線，像站牌上的資訊欄。 */
			.facts {
				display: grid;
				margin: var(--s-6) 0 0;
				border-top: var(--rule-thin) solid var(--rule);
			}
			@media (min-width: 760px) {
				.facts {
					grid-template-columns: repeat(4, minmax(0, 1fr));
					column-gap: var(--col-gap);
				}
			}
			.facts > div {
				padding-block: var(--s-2);
				border-bottom: var(--rule-thin) solid var(--rule);
			}
			@media (min-width: 760px) {
				.facts > div {
					border-bottom: 0;
				}
			}
			.facts dt {
				color: var(--text-2);
				font-size: 0.875rem;
				line-height: 1.71;
			}
			.facts dd {
				margin: 0;
				font-weight: 700;
			}

			.intro {
				font-size: 1.125rem;
			}


			.work-links {
				margin-bottom: 0;
				padding: 0;
				list-style: none;
				font-weight: 700;
			}
			.work-links li + li {
				margin-top: var(--s-1);
			}

			/* --- 流程：編號、標題、說明三欄，細線分隔，看得見的網格 --- */
			.steps {
				margin-bottom: 0;
				padding: 0;
				list-style: none;
				border-top: var(--rule-thick) solid var(--rule);
			}
			.steps li {
				display: grid;
				grid-template-columns: 3rem minmax(0, 1fr);
				column-gap: var(--col-gap);
				padding-block: var(--s-3);
				border-bottom: var(--rule-thin) solid var(--rule);
			}
			@media (min-width: 960px) {
				.steps li {
					grid-template-columns: 4rem minmax(0, 4fr) minmax(0, 6fr);
				}
			}
			.step-no {
				grid-row: span 2;
				color: var(--accent);
				font-size: 1.5rem;
				font-weight: 700;
				line-height: 1.33;
				font-variant-numeric: tabular-nums;
			}
			@media (min-width: 960px) {
				.step-no {
					grid-row: auto;
				}
			}
			.steps p {
				color: var(--text-2);
			}

			/* --- 承接範圍：色條標題＋單欄散文 --- */

			/* --- 聯絡：兩欄表格 --- */
			.info th {
				width: 30%;
				color: var(--text-2);
				font-size: 0.875rem;
				font-weight: 700;
			}
			.info tr:first-child > * {
				border-top: var(--rule-thick) solid var(--rule);
			}
			.info td {
				font-weight: 700;
				overflow-wrap: anywhere;
			}
			.empty {
				color: var(--text-2);
			}
		</style>
	</body>
</html>
