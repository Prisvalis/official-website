---
// 首頁。取代原本的 ComingSoon —— 公司已經在營運，官網不該還掛著「即將上線」。
//
// 文案全部在 src/i18n/home.ts，這裡只負責結構與樣式。背景層、卡片與頁首頁尾
// 沿用聯絡頁那一套視覺語彙（--surface / --border / backdrop-filter）。
import BaseHead from "../components/BaseHead.astro";
import { COMPANY, SOCIAL, LOCALE_HOME_PATH, type Locale } from "../consts";
import { t } from "../i18n/ui";
import { home } from "../i18n/home";
import { cooUrl } from "../i18n/coo";

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const htmlLang = t(locale, "html.lang");
const otherLocale: Locale = locale === "zh-Hant" ? "en" : "zh-Hant";
// 相對路徑：切換語言時留在訪客當下的網域，不要跳回 SITE。
const switchHref = LOCALE_HOME_PATH[otherLocale];
const contactHref = locale === "en" ? "/en/contact/" : "/contact/";
const cooHref = cooUrl(locale, "/");

const c = home[locale];
const year = new Date().getFullYear();
---

<!doctype html>
<html lang={htmlLang}>
	<head>
		<BaseHead locale={locale} />
	</head>
	<body>
		<div class="glow" aria-hidden="true"></div>
		<div class="grid" aria-hidden="true"></div>

		<div class="page">
			<header class="topbar">
				<a class="brand" href={LOCALE_HOME_PATH[locale]}>
					<img
						class="brand-logo"
						src="/logo.png"
						alt={COMPANY.nameEn}
						width="583"
						height="86"
					/>
				</a>

				<nav class="controls">
					<a class="control nav-link" href={cooHref}>{c.product.title}</a>
					<a class="control nav-link" href={contactHref}>{c.closing.cta}</a>
					<a class="control" href={switchHref} aria-label={t(locale, "switch.aria")}>
						{t(locale, "switch.to")}
					</a>
					<button
						id="theme-toggle"
						class="control icon-btn"
						type="button"
						aria-label={t(locale, "theme.aria")}
						title={t(locale, "theme.aria")}
					>
						<svg class="icon sun" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
							<circle cx="12" cy="12" r="4.2" fill="currentColor"></circle>
							<g stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
								<line x1="12" y1="2.5" x2="12" y2="5"></line>
								<line x1="12" y1="19" x2="12" y2="21.5"></line>
								<line x1="2.5" y1="12" x2="5" y2="12"></line>
								<line x1="19" y1="12" x2="21.5" y2="12"></line>
								<line x1="5.2" y1="5.2" x2="6.9" y2="6.9"></line>
								<line x1="17.1" y1="17.1" x2="18.8" y2="18.8"></line>
								<line x1="18.8" y1="5.2" x2="17.1" y2="6.9"></line>
								<line x1="6.9" y1="17.1" x2="5.2" y2="18.8"></line>
							</g>
						</svg>
						<svg class="icon moon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
							<path fill="currentColor" d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
						</svg>
					</button>
				</nav>
			</header>

			<main>
				<section class="hero">
					<p class="eyebrow">{c.hero.eyebrow}</p>
					<h1 class="hero-title">{c.hero.h1}</h1>
					<p class="hero-lead">{c.hero.lead}</p>
					<div class="hero-actions">
						<a class="btn btn-primary" href={contactHref}>
							{c.hero.ctaPrimary}
							<span aria-hidden="true">→</span>
						</a>
						<a class="btn btn-ghost" href={cooHref}>{c.hero.ctaSecondary}</a>
					</div>
				</section>

				<section class="section">
					<div class="section-head">
						<p class="eyebrow">{c.approach.eyebrow}</p>
						<h2 class="section-title">{c.approach.title}</h2>
					</div>
					<ul class="cards cards-3">
						{
							c.approach.items.map((item) => (
								<li class="card">
									<h3 class="card-title">{item.title}</h3>
									<p class="card-body">{item.body}</p>
								</li>
							))
						}
					</ul>
				</section>

				<section class="section">
					<div class="section-head">
						<p class="eyebrow">{c.services.eyebrow}</p>
						<h2 class="section-title">{c.services.title}</h2>
						<p class="section-lead">{c.services.lead}</p>
					</div>
					<ul class="cards cards-3">
						{
							c.services.items.map((item) => (
								<li class="card">
									<h3 class="card-title">{item.title}</h3>
									{item.tag && <p class="card-tag">{item.tag}</p>}
									<p class="card-body">{item.body}</p>
								</li>
							))
						}
					</ul>
				</section>

				<section class="section">
					<div class="section-head">
						<p class="eyebrow">{c.audience.eyebrow}</p>
						<h2 class="section-title">{c.audience.title}</h2>
					</div>
					<ul class="cards cards-2">
						{
							c.audience.items.map((item) => (
								<li class="card">
									<h3 class="card-title">{item.title}</h3>
									<p class="card-body">{item.body}</p>
								</li>
							))
						}
					</ul>
				</section>

				<section class="section">
					<div class="panel">
						<p class="eyebrow">{c.compute.eyebrow}</p>
						<h2 class="section-title">{c.compute.title}</h2>
						{c.compute.body.map((para) => <p class="panel-body">{para}</p>)}
					</div>
				</section>

				<section class="section">
					<div class="panel panel-product">
						<p class="eyebrow">{c.product.eyebrow}</p>
						<h2 class="section-title">{c.product.title}</h2>
						<p class="panel-body">{c.product.lead}</p>
						<ul class="points">
							{c.product.points.map((point) => <li>{point}</li>)}
						</ul>
						<p class="note">{c.product.note}</p>
						<a class="btn btn-ghost" href={cooHref}>
							{c.product.cta}
							<span aria-hidden="true">→</span>
						</a>
					</div>
				</section>

				<section class="section closing">
					<h2 class="section-title">{c.closing.title}</h2>
					<p class="section-lead">{c.closing.body}</p>
					<a class="btn btn-primary" href={contactHref}>
						{c.closing.cta}
						<span aria-hidden="true">→</span>
					</a>
				</section>
			</main>

			<footer class="site-footer">
				<div class="social">
					<a
						class="social-link"
						href={SOCIAL.instagram}
						target="_blank"
						rel="me noopener noreferrer"
						aria-label={`${COMPANY.shortEn} · Instagram`}
					>
						<svg
							viewBox="0 0 24 24"
							width="20"
							height="20"
							aria-hidden="true"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
						>
							<rect x="2.5" y="2.5" width="19" height="19" rx="5.5"></rect>
							<circle cx="12" cy="12" r="4.2"></circle>
							<circle cx="17.4" cy="6.6" r="1.15" fill="currentColor" stroke="none"></circle>
						</svg>
					</a>
					<a
						class="social-link"
						href={SOCIAL.threads}
						target="_blank"
						rel="me noopener noreferrer"
						aria-label={`${COMPANY.shortEn} · Threads`}
					>
						<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
							<path
								fill="currentColor"
								d="M12.186 24h-.007c-3.581-.024-6.334-1.205-8.184-3.509C2.35 18.44 1.5 15.586 1.472 12.01v-.017c.03-3.579.879-6.43 2.525-8.482C5.845 1.205 8.6.024 12.18 0h.014c2.746.02 5.043.725 6.826 2.098 1.677 1.29 2.858 3.13 3.509 5.467l-2.04.569c-1.104-3.96-3.898-5.984-8.304-6.015-2.91.022-5.11.936-6.54 2.717C4.307 6.504 3.616 8.914 3.589 12c.027 3.086.718 5.496 2.057 7.166 1.43 1.781 3.63 2.695 6.54 2.717 2.623-.02 4.354-.634 5.798-2.05 1.658-1.626 1.629-3.626 1.116-4.83-.298-.7-.847-1.281-1.591-1.711-.187 1.318-.593 2.362-1.214 3.115-.83 1.006-2.008 1.557-3.501 1.635-1.128.059-2.212-.208-3.053-.752-.994-.643-1.574-1.626-1.634-2.766-.059-1.115.379-2.14 1.234-2.887.821-.717 1.98-1.137 3.44-1.25a13.87 13.87 0 0 1 2.982.126c-.132-.79-.399-1.407-.795-1.844-.535-.591-1.362-.892-2.459-.899h-.034c-.882 0-2.077.243-2.838 1.383l-1.68-1.13c1.019-1.51 2.674-2.341 4.659-2.341h.052c3.316.021 5.293 2.049 5.485 5.538.11.045.216.093.32.144 1.469.69 2.545 1.735 3.109 3.024.786 1.797.833 4.726-1.485 6.998-1.771 1.737-3.921 2.521-6.849 2.521z"
							></path>
						</svg>
					</a>
				</div>
				<p class="copyright">© {year} {COMPANY.nameEn} · {t(locale, "rights")}</p>
				<p class="copyright">{t(locale, "taxId")} {COMPANY.taxId}</p>
			</footer>
		</div>

		<script is:inline>
			(function () {
				var btn = document.getElementById("theme-toggle");
				if (!btn) return;
				btn.addEventListener("click", function () {
					var root = document.documentElement;
					var next = root.dataset.theme === "dark" ? "light" : "dark";
					root.dataset.theme = next;
					try {
						localStorage.setItem("theme", next);
					} catch (e) {}
				});
			})();
		</script>

		<style>
			.page {
				position: relative;
				z-index: 1;
				min-height: 100svh;
				max-width: 1080px;
				margin: 0 auto;
				padding: clamp(1.25rem, 3vw, 2.25rem);
				display: flex;
				flex-direction: column;
			}

			/* 背景層。與聯絡頁同一套做法，故意複製而非抽共用元件 ——
			   兩個版面的背景若要一起改，改兩處遠比多一層抽象容易追。 */
			.glow {
				position: fixed;
				inset: 0;
				z-index: 0;
				background:
					radial-gradient(60% 55% at 50% 0%, var(--glow-1), transparent 70%),
					radial-gradient(45% 45% at 85% 25%, var(--glow-2), transparent 70%);
				pointer-events: none;
			}
			.grid {
				position: fixed;
				inset: 0;
				z-index: 0;
				background-image:
					linear-gradient(to right, var(--grid) 1px, transparent 1px),
					linear-gradient(to bottom, var(--grid) 1px, transparent 1px);
				background-size: 48px 48px;
				mask-image: radial-gradient(70% 60% at 50% 40%, #000 40%, transparent 100%);
				-webkit-mask-image: radial-gradient(70% 60% at 50% 40%, #000 40%, transparent 100%);
				pointer-events: none;
			}

			.topbar {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 1rem;
			}
			.brand {
				display: inline-flex;
				align-items: center;
			}
			.brand-logo {
				display: block;
				height: 28px;
				width: auto;
			}
			.controls {
				display: flex;
				align-items: center;
				gap: 0.5rem;
				flex-wrap: wrap;
				justify-content: flex-end;
			}
			.control {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				height: 40px;
				padding: 0 0.9rem;
				border: 1px solid var(--border);
				border-radius: 10px;
				background: var(--surface);
				color: var(--text);
				font-size: 0.9rem;
				font-weight: 500;
				text-decoration: none;
				backdrop-filter: blur(8px);
				cursor: pointer;
				transition: border-color 0.2s ease, transform 0.15s ease;
			}
			.control:hover {
				border-color: var(--accent);
				transform: translateY(-1px);
			}
			.icon-btn {
				width: 40px;
				padding: 0;
			}
			.icon {
				display: block;
			}
			:root[data-theme="dark"] .sun {
				display: none;
			}
			:root:not([data-theme="dark"]) .moon {
				display: none;
			}

			main {
				flex: 1;
			}

			.eyebrow {
				margin: 0;
				color: var(--accent);
				font-size: 0.82rem;
				font-weight: 600;
				letter-spacing: 0.08em;
			}

			.hero {
				padding: clamp(3rem, 9vw, 6rem) 0 clamp(2.5rem, 6vw, 4rem);
			}
			.hero-title {
				margin: 0.9rem 0 0;
				/* em 而非 ch：ch 以「0」的字寬為基準，中日韓字元約是它的兩倍，
				   同一個數值在兩種文字下代表的字數會差一倍。 */
				max-width: 18em;
				font-size: clamp(2.1rem, 6vw, 3.4rem);
				line-height: 1.18;
				letter-spacing: -0.02em;
				font-weight: 800;
			}
			.hero-lead {
				margin: 1.2rem 0 0;
				max-width: 40em;
				color: var(--text-muted);
				font-size: clamp(1rem, 2.2vw, 1.15rem);
				line-height: 1.75;
			}
			.hero-actions {
				display: flex;
				flex-wrap: wrap;
				gap: 0.75rem;
				margin-top: 2rem;
			}

			.btn {
				display: inline-flex;
				align-items: center;
				gap: 0.5rem;
				padding: 0.8rem 1.6rem;
				border-radius: 12px;
				font-weight: 600;
				font-size: 0.95rem;
				text-decoration: none;
				transition: transform 0.15s ease, border-color 0.2s ease;
			}
			.btn:hover {
				transform: translateY(-2px);
			}
			.btn-primary {
				border: 0;
				color: #fff;
				background: linear-gradient(135deg, var(--accent), var(--accent-2));
				box-shadow: var(--shadow);
			}
			.btn-ghost {
				border: 1px solid var(--border);
				background: var(--surface);
				/* 不要用 --text-muted：hover 時前景與背景的對比會掉到看不清楚。 */
				color: var(--text);
				backdrop-filter: blur(8px);
			}
			.btn-ghost:hover {
				border-color: var(--accent);
			}

			.section {
				padding: clamp(2.5rem, 6vw, 4rem) 0;
			}
			.section-head {
				margin-bottom: clamp(1.5rem, 4vw, 2.25rem);
			}
			.section-title {
				margin: 0.7rem 0 0;
				max-width: 26em;
				font-size: clamp(1.5rem, 3.6vw, 2.1rem);
				line-height: 1.3;
				letter-spacing: -0.015em;
				font-weight: 700;
			}
			.section-lead {
				margin: 0.9rem 0 0;
				max-width: 40em;
				color: var(--text-muted);
				font-size: 1rem;
				line-height: 1.75;
			}

			.cards {
				margin: 0;
				padding: 0;
				list-style: none;
				display: grid;
				gap: 1rem;
			}
			.cards-3 {
				grid-template-columns: repeat(3, minmax(0, 1fr));
			}
			.cards-2 {
				grid-template-columns: repeat(2, minmax(0, 1fr));
			}

			.card,
			.panel {
				padding: clamp(1.25rem, 3vw, 1.75rem);
				border: 1px solid var(--border);
				border-radius: 14px;
				background: var(--surface);
				backdrop-filter: blur(8px);
				box-shadow: var(--shadow);
			}
			.card-title {
				margin: 0;
				font-size: 1.05rem;
				font-weight: 700;
				letter-spacing: -0.01em;
			}
			/* 服務項目的技術標籤。點名到具體產品，客戶一眼就知道在賣什麼。 */
			.card-tag {
				margin: 0.45rem 0 0;
				color: var(--accent);
				font-size: 0.8rem;
				font-weight: 600;
				letter-spacing: 0.02em;
			}
			.card-body {
				margin: 0.7rem 0 0;
				color: var(--text-muted);
				font-size: 0.93rem;
				line-height: 1.75;
			}

			.panel-body {
				margin: 0.9rem 0 0;
				max-width: 46em;
				color: var(--text-muted);
				font-size: 0.98rem;
				line-height: 1.8;
			}
			.panel-product .section-title {
				font-size: clamp(1.6rem, 4vw, 2.2rem);
			}
			.points {
				margin: 1.1rem 0 0;
				padding: 0;
				list-style: none;
				display: grid;
				gap: 0.6rem;
				max-width: 46em;
			}
			.points li {
				position: relative;
				padding-left: 1.5rem;
				color: var(--text-muted);
				font-size: 0.93rem;
				line-height: 1.7;
			}
			.points li::before {
				content: "";
				position: absolute;
				left: 0;
				top: 0.6em;
				width: 6px;
				height: 6px;
				border-radius: 50%;
				background: var(--accent);
			}
			.note {
				margin: 1.1rem 0 1.5rem;
				color: var(--text-muted);
				font-size: 0.82rem;
				line-height: 1.6;
			}

			.closing {
				text-align: center;
				padding-bottom: clamp(3rem, 7vw, 5rem);
			}
			.closing .section-title,
			.closing .section-lead {
				margin-left: auto;
				margin-right: auto;
			}
			.closing .btn {
				margin-top: 1.75rem;
			}

			.site-footer {
				text-align: center;
				padding-top: 2rem;
				border-top: 1px solid var(--border);
			}
			.social {
				display: flex;
				justify-content: center;
				gap: 0.75rem;
				margin-bottom: 1rem;
			}
			.social-link {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				width: 40px;
				height: 40px;
				border: 1px solid var(--border);
				border-radius: 10px;
				background: var(--surface);
				color: var(--text);
				transition: border-color 0.2s ease, transform 0.15s ease;
			}
			.social-link:hover {
				border-color: var(--accent);
				transform: translateY(-1px);
			}
			.copyright {
				margin: 0;
				color: var(--text-muted);
				font-size: 0.85rem;
			}

			@media (max-width: 900px) {
				.cards-3 {
					grid-template-columns: repeat(2, minmax(0, 1fr));
				}
			}

			@media (max-width: 640px) {
				.cards-3,
				.cards-2 {
					grid-template-columns: minmax(0, 1fr);
				}
				/* 窄螢幕上四個控制項會擠成三列堆在 logo 旁邊。頁首的兩條內容連結
				   在 hero 與結尾各有一個更明顯的 CTA 指向同一處，這裡收起不損失動線。 */
				.nav-link {
					display: none;
				}
				.brand-logo {
					height: 24px;
				}
				.hero-actions .btn {
					flex: 1 1 auto;
					justify-content: center;
				}
			}
		</style>
	</body>
</html>
