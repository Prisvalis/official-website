---
// 首頁。文案全部在 src/i18n/home.ts，這裡只負責結構與版面。
//
// 設計依 docs/brand-spec.md（Linear recipe）。各區塊刻意用不同的形式，避免整頁都是
// 「標題＋卡片列」的模板節奏：開頭是左大右小的不對稱構圖、作品是左欄標題右欄表格、
// 流程是橫向編號、承接範圍是單欄散文、聯絡是左文右清單。
// 共用樣式在 styles/global.css，頁首與頁尾在 SiteHeader、SiteFooter。
import BaseHead from "../components/BaseHead.astro";
import MourningNotice from "../components/MourningNotice.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { COMPANY, LOCALE_HOME_PATH, SOCIAL, type Locale } from "../consts";
import { t } from "../i18n/ui";
import { home } from "../i18n/home";
import { cooUrl, APP_URL, COO_NAME } from "../i18n/coo";
import { about, ABOUT_PATH } from "../i18n/about";

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const htmlLang = t(locale, "html.lang");
const otherLocale: Locale = locale === "zh-Hant" ? "en" : "zh-Hant";
// 相對路徑：切換語言時留在訪客當下的網域，不要跳回 SITE。
const switchHref = LOCALE_HOME_PATH[otherLocale];
const contactHref = locale === "en" ? "/en/contact/" : "/contact/";
const hasPhone = COMPANY.phone !== "-";
const hasLine = COMPANY.lineId !== "-";
const telHref = `tel:${COMPANY.phone.replace(/[^\d+]/g, "")}`;
const lineHref = COMPANY.lineUrl;
const instagramHandle = `@${SOCIAL.instagram.split("/").filter(Boolean).pop()}`;
const cooHref = cooUrl(locale, "/");
const statusHref = cooUrl(locale, "/#status");
const external = t(locale, "link.external");

const c = home[locale];
const a = about[locale];

// 開頭右欄的公司資料，直接取自沿革頁的登記資料表（統一編號、公司所在地、核准設立日期），
// 不另外寫一份。沿革頁的表格順序改了，這裡的索引要跟著改。
const facts = [0, 7, 9].map((i) => a.profile.rows[i]);

const sections = [
	{ id: "work", label: c.work.title },
	{ id: "process", label: c.process.title },
	{ id: "scope", label: c.scope.title },
	{ id: "contact", label: c.contact.title },
];

const nav = [
	...sections.slice(0, 3).map((s) => ({ href: `#${s.id}`, label: s.label })),
	{ href: ABOUT_PATH[locale], label: a.navLabel },
	{ href: cooHref, label: COO_NAME },
	{ href: contactHref, label: t(locale, "nav.contact") },
];
---

<!doctype html>
<html lang={htmlLang}>
	<head>
		<BaseHead locale={locale} />
	</head>
	<body>
		<MourningNotice locale={locale} />
		<SiteHeader locale={locale} homeHref={LOCALE_HOME_PATH[locale]} switchHref={switchHref} nav={nav} />

		<main id="main">
			<section class="hero">
				<div class="wrap hero-grid">
					<div class="hero-main">
						<h1 class="rise">{c.hero.h1}</h1>
						<p class="lead measure rise rise-2">{c.hero.lead}</p>
						<div class="actions rise rise-3">
							<a class="btn btn-primary" href={contactHref}>{c.hero.ctaPrimary}</a>
							<a class="btn" href={cooHref}>{c.hero.ctaSecondary}</a>
						</div>
					</div>

					<aside class="facts rise rise-3" aria-label={a.profile.title}>
						<dl>
							{
								facts.map((f, i) => (
									<div>
										<dt>{f.label}</dt>
										<dd>{i === 0 ? <span class="chip">{f.value}</span> : f.value}</dd>
									</div>
								))
							}
						</dl>
						<a class="facts-more" href={ABOUT_PATH[locale]}>{a.navLabel}</a>
					</aside>
				</div>
			</section>

			<section class="section" id="work">
				<div class="wrap split">
					<header class="split-head">
						<h2>{c.work.title}</h2>
						<p class="lead">{c.work.lead}</p>
						<ul class="work-links">
							<li><a href={cooHref}>{c.work.links.product}</a></li>
							<li>
								<a href={APP_URL} target="_blank" rel="noopener noreferrer">
									{c.work.links.demo}
									<svg
										class="ext"
										viewBox="0 0 24 24"
										width="12"
										height="12"
										aria-hidden="true"
										fill="none"
										stroke="currentColor"
										stroke-width="2.2"
										stroke-linecap="round"
										stroke-linejoin="round"><path d="M7 17 17 7M8 7h9v9"></path></svg
									>
									<span class="sr-only">{external}</span>
								</a>
							</li>
						</ul>
					</header>

					<div class="split-body">
						<div class="table-scroll">
							<table>
								<caption>{c.work.caption}</caption>
								<thead>
									<tr>
										<th scope="col">{c.work.columns.area}</th>
										<th scope="col">{c.work.columns.approach}</th>
										<th scope="col">{c.work.columns.reason}</th>
									</tr>
								</thead>
								<tbody>
									{
										c.work.rows.map((row) => (
											<tr>
												<th scope="row">{row.area}</th>
												<td>{row.approach}</td>
												<td>{row.reason}</td>
											</tr>
										))
									}
								</tbody>
							</table>
						</div>

						<div class="notice">
							<p>
								{c.work.limits}
								<a href={statusHref}>{c.work.links.status}</a>
							</p>
						</div>

						<!-- v0 佔位：Company of One 的真實介面截圖由站方提供（#26 素材清單）。 -->
						<div class="placeholder" role="img" aria-label={COO_NAME}>
							{locale === "en" ? "[Company of One screenshot, 16:9]" : "[Company of One 介面截圖 16:9]"}
						</div>
					</div>
				</div>
			</section>

			<section class="section" id="process">
				<div class="wrap">
					<h2>{c.process.title}</h2>
					<ol class="steps">
						{
							c.process.steps.map((step, i) => (
								<li>
									<span class="step-no" aria-hidden="true">
										{String(i + 1).padStart(2, "0")}
									</span>
									<h3>{step.title}</h3>
									<p>{step.body}</p>
								</li>
							))
						}
					</ol>
				</div>
			</section>

			<section class="section" id="scope">
				<div class="wrap">
					<h2>{c.scope.title}</h2>
					<div class="prose measure">
						{c.scope.body.map((para) => <p>{para}</p>)}
					</div>
				</div>
			</section>

			<section class="section" id="contact">
				<div class="wrap split">
					<header class="split-head">
						<h2>{c.contact.title}</h2>
						<p class="lead">{c.contact.body}</p>
						<div class="actions">
							<a class="btn" href={`${contactHref}#form`}>{t(locale, "contact.form.title")}</a>
						</div>
					</header>

					<dl class="info split-body">
						<div>
							<dt>{t(locale, "contact.info.phone")}</dt>
							<dd>
								{
									hasPhone ? (
										<a href={telHref}>{COMPANY.phone}</a>
									) : (
										<span class="empty">
											{COMPANY.phone}
											<span class="sr-only">{t(locale, "contact.info.pending")}</span>
										</span>
									)
								}
							</dd>
						</div>
						<div>
							<dt>{t(locale, "contact.info.email")}</dt>
							<dd><a href={`mailto:${COMPANY.email}`}>{COMPANY.email}</a></dd>
						</div>
						<div>
							<dt>{t(locale, "contact.info.line")}</dt>
							<dd>
								{
									hasLine ? (
										<a href={lineHref} target="_blank" rel="noopener noreferrer">
											{COMPANY.lineId}
											<span class="sr-only">{external}</span>
										</a>
									) : (
										<span class="empty">
											{COMPANY.lineId}
											<span class="sr-only">{t(locale, "contact.info.pending")}</span>
										</span>
									)
								}
							</dd>
						</div>
						<div>
							<dt>{t(locale, "contact.info.instagram")}</dt>
							<dd>
								<a href={SOCIAL.instagram} target="_blank" rel="me noopener noreferrer">
									{instagramHandle}
									<span class="sr-only">{external}</span>
								</a>
							</dd>
						</div>
						<div>
							<dt>{t(locale, "contact.info.reply")}</dt>
							<dd>{t(locale, "contact.info.replyValue")}</dd>
						</div>
					</dl>
				</div>
			</section>
		</main>

		<SiteFooter
			locale={locale}
			links={[
				{ href: ABOUT_PATH[locale], label: a.navLabel },
				{ href: cooHref, label: COO_NAME },
				{ href: contactHref, label: t(locale, "nav.contact") },
			]}
		/>

		<style>
			/* --- 開頭：左大右小，頂端一層品牌紅微光（brand-spec §9-4）--- */
			.hero {
				position: relative;
				padding-block: var(--s-7) var(--s-7);
				background: radial-gradient(60% 120% at 20% 0%, var(--glow), transparent 70%);
			}
			@media (min-width: 760px) {
				.hero {
					padding-block: var(--s-8) var(--s-8);
				}
			}
			.hero-grid {
				display: grid;
				gap: var(--s-6);
			}
			@media (min-width: 960px) {
				.hero-grid {
					grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
					align-items: end;
					gap: var(--s-7);
				}
			}
			.hero-main .lead {
				margin-top: var(--s-5);
			}
			.actions {
				display: flex;
				flex-wrap: wrap;
				gap: var(--s-3);
				margin-top: var(--s-6);
			}

			.facts {
				padding: var(--s-5);
				border: 1px solid var(--hairline);
				border-radius: var(--radius-m);
				background: var(--surface-1);
				box-shadow: var(--shadow);
			}
			.facts dl {
				display: grid;
				gap: var(--s-4);
				margin: 0;
			}
			.facts dt {
				color: var(--text-2);
				font-size: 0.8125rem;
			}
			.facts dd {
				margin: var(--s-1) 0 0;
				font-size: 0.9375rem;
			}
			.facts-more {
				display: inline-block;
				margin-top: var(--s-5);
				font-size: 0.875rem;
			}

			/* --- 左欄標題、右欄內容 --- */
			.split {
				display: grid;
				gap: var(--s-6);
			}
			@media (min-width: 960px) {
				.split {
					grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
					gap: var(--s-7);
				}
				.split-head {
					position: sticky;
					top: 96px;
					align-self: start;
				}
			}
			.split-head .lead {
				margin-top: var(--s-4);
				font-size: 1rem;
			}
			.split-body {
				display: grid;
				gap: var(--s-5);
				align-content: start;
			}

			.work-links {
				display: grid;
				gap: var(--s-2);
				margin: var(--s-5) 0 0;
				padding: 0;
				list-style: none;
				font-size: 0.9375rem;
			}
			.work-links li {
				display: flex;
				align-items: baseline;
			}
			.work-links li::before {
				content: "";
				flex: none;
				width: 6px;
				height: 6px;
				margin-right: var(--s-3);
				background: var(--accent);
				transform: translateY(-2px);
			}

			.table-scroll {
				overflow-x: auto;
			}
			.table-scroll table {
				min-width: 36em;
			}

			/* --- 流程：橫向編號 --- */
			.steps {
				display: grid;
				gap: var(--s-6) var(--s-5);
				margin: var(--s-6) 0 0;
				padding: 0;
				list-style: none;
			}
			@media (min-width: 760px) {
				.steps {
					grid-template-columns: repeat(2, minmax(0, 1fr));
				}
			}
			@media (min-width: 1100px) {
				.steps {
					grid-template-columns: repeat(4, minmax(0, 1fr));
				}
			}
			.steps li {
				padding-top: var(--s-4);
				border-top: 1px solid var(--hairline);
			}
			.step-no {
				display: flex;
				align-items: center;
				color: var(--text-2);
				font-family: var(--font-mono);
				font-size: 0.8125rem;
			}
			.step-no::before {
				content: "";
				width: 6px;
				height: 6px;
				margin-right: var(--s-2);
				background: var(--accent);
			}
			.steps h3 {
				margin-top: var(--s-3);
			}
			.steps p {
				margin-top: var(--s-2);
				color: var(--text-2);
				font-size: 0.9375rem;
			}

			/* --- 承接範圍：單欄散文 --- */
			.prose {
				display: grid;
				gap: var(--s-4);
				margin-top: var(--s-5);
				font-size: 1.0625rem;
			}

			/* --- 聯絡：細框線清單 --- */
			.info {
				margin: 0;
				border-top: 1px solid var(--hairline);
			}
			.info > div {
				display: grid;
				grid-template-columns: minmax(7em, 1fr) 2fr;
				gap: var(--s-4);
				padding-block: var(--s-4);
				border-bottom: 1px solid var(--hairline);
			}
			.info dt {
				color: var(--text-2);
				font-size: 0.875rem;
			}
			.info dd {
				margin: 0;
				font-weight: 500;
				overflow-wrap: anywhere;
			}
			.empty {
				color: var(--text-2);
			}
		</style>
	</body>
</html>
