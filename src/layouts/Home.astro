---
// 首頁。文案全部在 src/i18n/home.ts，這裡只負責結構與版面。
//
// 華國美學版：外框（頁首、主選單、跑馬燈、側欄、頁尾）由 PortalShell 提供，
// 這裡只放內容區塊。每個區塊是一個有標題列的框，形式仍然各自不同：
// 表格、編號清單、散文、一句話加按鈕。共用樣式在 styles/global.css。
import BaseHead from "../components/BaseHead.astro";
import PortalShell from "../components/PortalShell.astro";
import WordArt from "../components/WordArt.astro";
import { COMPANY, LOCALE_HOME_PATH, type Locale } from "../consts";
import { t } from "../i18n/ui";
import { home } from "../i18n/home";
import { cooUrl, APP_URL, REPO_URL } from "../i18n/coo";

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const htmlLang = t(locale, "html.lang");
const otherLocale: Locale = locale === "zh-Hant" ? "en" : "zh-Hant";
// 相對路徑：切換語言時留在訪客當下的網域，不要跳回 SITE。
const switchHref = LOCALE_HOME_PATH[otherLocale];
const contactHref = locale === "en" ? "/en/contact/" : "/contact/";
const cooHref = cooUrl(locale, "/");
const statusHref = cooUrl(locale, "/#status");
const external = t(locale, "link.external");

const c = home[locale];
---

<!doctype html>
<html lang={htmlLang}>
	<head>
		<BaseHead locale={locale} />
	</head>
	<body>
		<PortalShell locale={locale} page="home" switchHref={switchHref}>

			<section class="hero">
				<div class="wrap cols">
					<WordArt text={c.hero.h1} class="hero-title" />
					<div class="hero-body">
						<p class="hero-lead">{c.hero.lead}</p>
						<div class="hero-actions">
							<a class="btn btn-primary" href={contactHref}>{c.hero.ctaPrimary}</a>
							<a class="btn" href={cooHref}>{c.hero.ctaSecondary}</a>
						</div>
					</div>
				</div>
			</section>

			<section class="section">
				<div class="wrap cols">
					<h2>{c.work.title}</h2>
					<div>
						<p class="prose">{c.work.lead}</p>

						<table class="work-table">
							<caption>{c.work.caption}</caption>
							<thead>
								<tr>
									<th scope="col">{c.work.columns.area}</th>
									<th scope="col">{c.work.columns.approach}</th>
									<th scope="col">{c.work.columns.reason}</th>
								</tr>
							</thead>
							<tbody>
								{
									c.work.rows.map((row) => (
										<tr>
											<th scope="row">{row.area}</th>
											<td data-label={c.work.columns.approach}>{row.approach}</td>
											<td data-label={c.work.columns.reason}>{row.reason}</td>
										</tr>
									))
								}
							</tbody>
						</table>

						<p class="limits prose">
							{c.work.limits}
							<a href={statusHref}>{c.work.links.status}</a>
						</p>

						<ul class="links">
							<li><a href={cooHref}>{c.work.links.product}</a></li>
							<li>
								<a href={REPO_URL} target="_blank" rel="noopener noreferrer">
									{c.work.links.repo}
									<svg
										class="ext"
										viewBox="0 0 24 24"
										width="14"
										height="14"
										aria-hidden="true"
										fill="none"
										stroke="currentColor"
										stroke-width="2"
										stroke-linecap="round"
										stroke-linejoin="round"><path d="M7 17 17 7M8 7h9v9"></path></svg
									>
									<span class="sr-only">{external}</span>
								</a>
							</li>
							<li>
								<a href={APP_URL} target="_blank" rel="noopener noreferrer">
									{c.work.links.demo}
									<svg
										class="ext"
										viewBox="0 0 24 24"
										width="14"
										height="14"
										aria-hidden="true"
										fill="none"
										stroke="currentColor"
										stroke-width="2"
										stroke-linecap="round"
										stroke-linejoin="round"><path d="M7 17 17 7M8 7h9v9"></path></svg
									>
									<span class="sr-only">{external}</span>
								</a>
							</li>
						</ul>
					</div>
				</div>
			</section>

			<section class="section">
				<div class="wrap cols">
					<h2>{c.process.title}</h2>
					<ol class="steps">
						{
							c.process.steps.map((step) => (
								<li>
									<h3>{step.title}</h3>
									<p>{step.body}</p>
								</li>
							))
						}
					</ol>
				</div>
			</section>

			<section class="section">
				<div class="wrap cols">
					<h2>{c.scope.title}</h2>
					<div class="prose scope-body">
						{c.scope.body.map((para) => <p>{para}</p>)}
					</div>
				</div>
			</section>

			<section class="section">
				<div class="wrap cols">
					<h2>{c.contact.title}</h2>
					<div>
						<p class="prose">{c.contact.body}</p>
						<div class="contact-actions">
							<a class="btn btn-primary" href={contactHref}>{c.contact.cta}</a>
							<p>
								{c.contact.email}
								<a href={`mailto:${COMPANY.email}`}>{COMPANY.email}</a>
							</p>
						</div>
					</div>
				</div>
			</section>
		</PortalShell>

		<style>
			.hero-actions {
				display: flex;
				flex-wrap: wrap;
				gap: 7.6px 10.4px;
				margin-top: 2.4px;
			}

			.work-table {
				margin-top: 11.2px;
			}
			.work-table th[scope="row"] {
				width: 20%;
			}
			.work-table td {
				width: 40%;
			}

			/* 限制照實寫：黃底警示框，文字本身就是完整說明。 */
			.limits {
				margin-top: 11.8px;
				padding: 7.2px 10.4px 7.6px 9.2px;
				background: var(--roc-yellow);
				border: 1px dashed var(--notice-border);
				border-left: 5px solid var(--roc-red);
				color: var(--notice-text);
			}
			.limits::before {
				content: "※ ";
				color: var(--roc-red);
				font-weight: 700;
			}
			:root[data-theme="dark"] .limits::before {
				color: #ff9d9d;
			}

			.links {
				display: flex;
				flex-wrap: wrap;
				gap: 4px 18.6px;
				margin: 10.4px 0 0;
				padding: 0;
				list-style: none;
				font-family: var(--font-ui);
			}
			.links li::before {
				content: "→ ";
				color: var(--roc-red);
			}

			/* 編號清單：像公文的「一、二、三、」條列，左邊一格編號。 */
			.steps {
				margin: 0;
				padding: 0;
				list-style: none;
				counter-reset: step;
				border: 1px solid var(--border);
			}
			.steps li {
				counter-increment: step;
				display: grid;
				grid-template-columns: 2.6em minmax(0, 1fr);
				gap: 0;
				border-top: 1px solid var(--border);
			}
			.steps li:first-child {
				border-top: 0;
			}
			.steps li::before {
				content: counter(step, cjk-decimal) "、";
				grid-row: 1 / span 2;
				padding: 6.4px 4px;
				background: var(--roc-blue-pale);
				border-right: 1px solid var(--border);
				color: var(--roc-blue);
				font-family: var(--font-kai);
				font-size: 17px;
				text-align: center;
			}
			:root[data-theme="dark"] .steps li::before {
				color: #fff27a;
			}
			:lang(en) .steps li::before {
				content: counter(step, decimal) ".";
				font-family: var(--font-latin);
				font-size: 15px;
				font-weight: 700;
			}
			.steps h3 {
				padding: 5.4px 9.6px 0 8.8px;
				color: var(--roc-red-2);
				font-size: 15.2px;
			}
			:root[data-theme="dark"] .steps h3 {
				color: #ff9d9d;
			}
			.steps p {
				padding: 1.6px 10.2px 6.8px 8.8px;
			}

			/* 散文區塊的每段前面加一個 ◆，像宣導單。 */
			.scope-body p::before {
				content: "◆ ";
				color: var(--roc-blue-3);
			}

			.contact-actions {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				gap: 8.4px 16.6px;
				margin-top: 11.6px;
				padding: 8.2px 10px;
				background: var(--roc-blue-pale);
				border: 1px solid var(--border);
			}

			@media (max-width: 40rem) {
				/* 窄螢幕上把表格攤成一列一組，欄位標籤由 data-label 補上。
				   表頭視覺上隱藏，但仍留給輔助技術。 */
				.work-table thead {
					position: absolute;
					width: 1px;
					height: 1px;
					overflow: hidden;
					clip: rect(0, 0, 0, 0);
				}
				.work-table tr,
				.work-table th,
				.work-table td {
					display: block;
					width: auto !important;
				}
				.work-table tr {
					border: 1px solid var(--border);
					border-top: 0;
				}
				.work-table th,
				.work-table td {
					border: 0;
				}
				.work-table th[scope="row"] {
					background: var(--roc-blue-pale);
				}
				.work-table td::before {
					content: "【" attr(data-label) "】";
					display: block;
					color: var(--muted);
					font-family: var(--font-ui);
					font-size: 12.4px;
					font-weight: 700;
				}
				.hero-actions .btn {
					flex: 1 1 auto;
					justify-content: center;
				}
			}
		</style>
	</body>
</html>
