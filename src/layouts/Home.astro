---
// 首頁。文案全部在 src/i18n/home.ts，這裡只負責結構與版面。
//
// 版面語彙（之後的聯絡頁與 CoO 沿用，共用的部分在 styles/global.css）：
// 左對齊、左窄右寬的不對稱兩欄、區塊之間只用留白與 1px 實線、不用卡片與陰影。
// 每個區塊刻意用不同的形式：表格、編號清單、散文、一句話加按鈕。
import BaseHead from "../components/BaseHead.astro";
import MourningNotice from "../components/MourningNotice.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import { COMPANY, SOCIAL, LOCALE_HOME_PATH, type Locale } from "../consts";
import { t } from "../i18n/ui";
import { home } from "../i18n/home";
import { cooUrl, APP_URL, REPO_URL, COO_NAME } from "../i18n/coo";

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const htmlLang = t(locale, "html.lang");
const otherLocale: Locale = locale === "zh-Hant" ? "en" : "zh-Hant";
// 相對路徑：切換語言時留在訪客當下的網域，不要跳回 SITE。
const switchHref = LOCALE_HOME_PATH[otherLocale];
const contactHref = locale === "en" ? "/en/contact/" : "/contact/";
const cooHref = cooUrl(locale, "/");
const statusHref = cooUrl(locale, "/#status");
const external = t(locale, "link.external");

const c = home[locale];
const year = new Date().getFullYear();
---

<!doctype html>
<html lang={htmlLang}>
	<head>
		<BaseHead locale={locale} />
	</head>
	<body>
		<MourningNotice locale={locale} />

		<header class="site-header">
			<div class="wrap">
				<a class="brand" href={LOCALE_HOME_PATH[locale]}>
					<img class="brand-logo" src="/logo.png" alt={COMPANY.nameEn} width="583" height="86" />
				</a>

				<nav class="site-nav">
					<a class="nav-link" href={cooHref}>{COO_NAME}</a>
					<a class="nav-link" href={contactHref}>{t(locale, "nav.contact")}</a>
					<a href={switchHref} aria-label={t(locale, "switch.aria")}>{t(locale, "switch.to")}</a>
					<ThemeToggle locale={locale} />
				</nav>
			</div>
		</header>

		<main>
			<section class="hero">
				<div class="wrap cols">
					<h1 class="hero-title">{c.hero.h1}</h1>
					<div class="hero-body">
						<p class="hero-lead">{c.hero.lead}</p>
						<div class="hero-actions">
							<a class="btn btn-primary" href={contactHref}>{c.hero.ctaPrimary}</a>
							<a class="btn" href={cooHref}>{c.hero.ctaSecondary}</a>
						</div>
					</div>
				</div>
			</section>

			<section class="section">
				<div class="wrap cols">
					<h2>{c.work.title}</h2>
					<div>
						<p class="prose">{c.work.lead}</p>

						<table class="work-table">
							<caption>{c.work.caption}</caption>
							<thead>
								<tr>
									<th scope="col">{c.work.columns.area}</th>
									<th scope="col">{c.work.columns.approach}</th>
									<th scope="col">{c.work.columns.reason}</th>
								</tr>
							</thead>
							<tbody>
								{
									c.work.rows.map((row) => (
										<tr>
											<th scope="row">{row.area}</th>
											<td data-label={c.work.columns.approach}>{row.approach}</td>
											<td data-label={c.work.columns.reason}>{row.reason}</td>
										</tr>
									))
								}
							</tbody>
						</table>

						<p class="limits prose">
							{c.work.limits}
							<a href={statusHref}>{c.work.links.status}</a>
						</p>

						<ul class="links">
							<li><a href={cooHref}>{c.work.links.product}</a></li>
							<li>
								<a href={REPO_URL} target="_blank" rel="noopener noreferrer">
									{c.work.links.repo}
									<svg
										class="ext"
										viewBox="0 0 24 24"
										width="14"
										height="14"
										aria-hidden="true"
										fill="none"
										stroke="currentColor"
										stroke-width="2"
										stroke-linecap="round"
										stroke-linejoin="round"><path d="M7 17 17 7M8 7h9v9"></path></svg
									>
									<span class="sr-only">{external}</span>
								</a>
							</li>
							<li>
								<a href={APP_URL} target="_blank" rel="noopener noreferrer">
									{c.work.links.demo}
									<svg
										class="ext"
										viewBox="0 0 24 24"
										width="14"
										height="14"
										aria-hidden="true"
										fill="none"
										stroke="currentColor"
										stroke-width="2"
										stroke-linecap="round"
										stroke-linejoin="round"><path d="M7 17 17 7M8 7h9v9"></path></svg
									>
									<span class="sr-only">{external}</span>
								</a>
							</li>
						</ul>
					</div>
				</div>
			</section>

			<section class="section">
				<div class="wrap cols">
					<h2>{c.process.title}</h2>
					<ol class="steps">
						{
							c.process.steps.map((step) => (
								<li>
									<h3>{step.title}</h3>
									<p>{step.body}</p>
								</li>
							))
						}
					</ol>
				</div>
			</section>

			<section class="section">
				<div class="wrap cols">
					<h2>{c.scope.title}</h2>
					<div class="prose">
						{c.scope.body.map((para) => <p>{para}</p>)}
					</div>
				</div>
			</section>

			<section class="section">
				<div class="wrap cols">
					<h2>{c.contact.title}</h2>
					<div>
						<p class="prose">{c.contact.body}</p>
						<div class="contact-actions">
							<a class="btn btn-primary" href={contactHref}>{c.contact.cta}</a>
							<p>
								{c.contact.email}
								<a href={`mailto:${COMPANY.email}`}>{COMPANY.email}</a>
							</p>
						</div>
					</div>
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="wrap">
				<div class="social">
					<a
						href={SOCIAL.instagram}
						target="_blank"
						rel="me noopener noreferrer"
						aria-label={`${COMPANY.shortEn} · Instagram`}
					>
						<svg
							viewBox="0 0 24 24"
							width="20"
							height="20"
							aria-hidden="true"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
						>
							<rect x="2.5" y="2.5" width="19" height="19" rx="5.5"></rect>
							<circle cx="12" cy="12" r="4.2"></circle>
							<circle cx="17.4" cy="6.6" r="1.15" fill="currentColor" stroke="none"></circle>
						</svg>
					</a>
					<a
						href={SOCIAL.threads}
						target="_blank"
						rel="me noopener noreferrer"
						aria-label={`${COMPANY.shortEn} · Threads`}
					>
						<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
							<path
								fill="currentColor"
								d="M12.186 24h-.007c-3.581-.024-6.334-1.205-8.184-3.509C2.35 18.44 1.5 15.586 1.472 12.01v-.017c.03-3.579.879-6.43 2.525-8.482C5.845 1.205 8.6.024 12.18 0h.014c2.746.02 5.043.725 6.826 2.098 1.677 1.29 2.858 3.13 3.509 5.467l-2.04.569c-1.104-3.96-3.898-5.984-8.304-6.015-2.91.022-5.11.936-6.54 2.717C4.307 6.504 3.616 8.914 3.589 12c.027 3.086.718 5.496 2.057 7.166 1.43 1.781 3.63 2.695 6.54 2.717 2.623-.02 4.354-.634 5.798-2.05 1.658-1.626 1.629-3.626 1.116-4.83-.298-.7-.847-1.281-1.591-1.711-.187 1.318-.593 2.362-1.214 3.115-.83 1.006-2.008 1.557-3.501 1.635-1.128.059-2.212-.208-3.053-.752-.994-.643-1.574-1.626-1.634-2.766-.059-1.115.379-2.14 1.234-2.887.821-.717 1.98-1.137 3.44-1.25a13.87 13.87 0 0 1 2.982.126c-.132-.79-.399-1.407-.795-1.844-.535-.591-1.362-.892-2.459-.899h-.034c-.882 0-2.077.243-2.838 1.383l-1.68-1.13c1.019-1.51 2.674-2.341 4.659-2.341h.052c3.316.021 5.293 2.049 5.485 5.538.11.045.216.093.32.144 1.469.69 2.545 1.735 3.109 3.024.786 1.797.833 4.726-1.485 6.998-1.771 1.737-3.921 2.521-6.849 2.521z"
							></path>
						</svg>
					</a>
				</div>
				<p>© {year} {COMPANY.nameEn} · {t(locale, "rights")}</p>
				<p>{t(locale, "taxId")} {COMPANY.taxId}</p>
			</div>
		</footer>

		<style>
			.hero {
				padding-block: clamp(3rem, 9vw, 6.5rem) clamp(3rem, 7vw, 5rem);
			}
			/* 標題橫跨兩欄，導言與按鈕落在右欄，與下面各區塊的內容欄對齊。
			   行寬用 em：ch 以「0」的字寬為基準，中日韓字元約是它的兩倍。 */
			.hero-title {
				grid-column: 1 / -1;
				max-width: 17em;
				font-size: clamp(2rem, 5.4vw, 3.4rem);
				line-height: 1.25;
			}
			.hero-body {
				display: grid;
				gap: 1.75rem;
				align-content: start;
			}
			@media (min-width: 56rem) {
				.hero-body {
					grid-column: 2;
				}
			}
			.hero-lead {
				max-width: 34em;
				font-size: clamp(1.05rem, 2vw, 1.2rem);
				line-height: 1.85;
			}
			.hero-actions {
				display: flex;
				flex-wrap: wrap;
				gap: 0.75rem 1rem;
			}

			.work-table {
				margin-top: 2rem;
			}
			.work-table th[scope="row"] {
				width: 22%;
			}
			.work-table td {
				width: 39%;
			}

			/* 限制照實寫。左邊的粗線只是標記，內容本身是完整的文字。 */
			.limits {
				margin-top: 1.75rem;
				padding-left: 1rem;
				border-left: 3px solid var(--accent);
			}

			.links {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem 1.75rem;
				margin: 1.5rem 0 0;
				padding: 0;
				list-style: none;
			}
			.ext {
				display: inline-block;
				margin-left: 0.2em;
				vertical-align: -0.1em;
			}

			.steps {
				margin: 0;
				padding: 0;
				list-style: none;
				counter-reset: step;
			}
			.steps li {
				counter-increment: step;
				display: grid;
				gap: 0.35rem 1.5rem;
				padding-block: 1.25rem;
				border-top: 1px solid var(--rule);
			}
			.steps li:first-child {
				padding-top: 0;
				border-top: 0;
			}
			.steps li::before {
				content: counter(step, decimal-leading-zero);
				color: var(--fg-secondary);
				font-family: var(--font-mono);
				font-size: 0.9rem;
			}
			@media (min-width: 40rem) {
				.steps li {
					grid-template-columns: 2.5rem minmax(9rem, 14rem) minmax(0, 1fr);
				}
			}

			.contact-actions {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				gap: 1rem 1.75rem;
				margin-top: 1.75rem;
			}

			.site-footer p {
				margin: 0;
			}

			@media (max-width: 40rem) {
				/* 窄螢幕上把表格攤成一列一組，欄位標籤由 data-label 補上。
				   表頭視覺上隱藏，但仍留給輔助技術。 */
				.work-table thead {
					position: absolute;
					width: 1px;
					height: 1px;
					overflow: hidden;
					clip: rect(0, 0, 0, 0);
				}
				.work-table tr,
				.work-table th,
				.work-table td {
					display: block;
					width: auto !important;
				}
				.work-table tr {
					padding-block: 0.9rem;
					border-top: 1px solid var(--rule);
				}
				.work-table th,
				.work-table td {
					padding: 0.1rem 0;
					border: 0;
				}
				.work-table td::before {
					content: attr(data-label);
					display: block;
					margin-top: 0.4rem;
					color: var(--fg-secondary);
					font-size: 0.8rem;
				}
			}

			@media (max-width: 40rem) {
				/* 窄螢幕上導覽與語言、主題按鈕會擠成幾列。頁首的兩條內容連結在
				   hero 與結尾各有一個更明顯的按鈕指向同一處，這裡收起不損失動線。 */
				.nav-link {
					display: none;
				}
				.brand-logo {
					height: 24px;
				}
				.hero-actions .btn {
					flex: 1 1 auto;
					justify-content: center;
				}
			}
		</style>
	</body>
</html>
