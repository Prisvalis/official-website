---
// 公司沿革。文案與登記資料在 src/i18n/about.ts，這裡只負責結構。
//
// 設計依 docs/brand-spec.md（Linear recipe）。開頭是標題、導言與頁內目錄，
// 之後每個段落都是首頁同一套「左欄標題、右欄內容」；登記資料一律用表格，
// 數字與代碼用等寬字。共用樣式在 styles/global.css。
import BaseHead from "../components/BaseHead.astro";
import MourningNotice from "../components/MourningNotice.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { SITE, LOCALE_HOME_PATH, type Locale } from "../consts";
import { t } from "../i18n/ui";
import { cooUrl, COO_NAME } from "../i18n/coo";
import { about, ABOUT_PATH, FINDBIZ_URL, ETAX_URL } from "../i18n/about";

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const otherLocale: Locale = locale === "zh-Hant" ? "en" : "zh-Hant";
// canonical 與 hreflang 用絕對網址指向 SITE；站內連結一律相對路徑。
const alternates: Record<Locale, string> = {
	"zh-Hant": new URL(ABOUT_PATH["zh-Hant"], SITE).href,
	en: new URL(ABOUT_PATH.en, SITE).href,
};
const homeHref = LOCALE_HOME_PATH[locale];
const contactHref = locale === "en" ? "/en/contact/" : "/contact/";
const external = t(locale, "link.external");

const c = about[locale];

const sections = [
	{ id: "origin", label: c.origin.title },
	{ id: "naming", label: c.naming.title },
	{ id: "vision", label: c.vision.title },
	{ id: "timeline", label: c.timeline.title },
	{ id: "profile", label: c.profile.title },
	{ id: "business", label: c.business.title },
];

const nav = [
	{ href: homeHref, label: t(locale, "contact.back") },
	{ href: ABOUT_PATH[locale], label: c.navLabel, current: true },
	{ href: cooUrl(locale, "/"), label: COO_NAME },
	{ href: contactHref, label: t(locale, "nav.contact") },
];
---

<!doctype html>
<html lang={t(locale, "html.lang")}>
	<head>
		<BaseHead locale={locale} title={c.metaTitle} description={c.metaDescription} alternates={alternates} />
	</head>
	<body>
		<MourningNotice locale={locale} />
		<SiteHeader locale={locale} homeHref={homeHref} switchHref={ABOUT_PATH[otherLocale]} nav={nav} />

		<main id="main">
			<header class="page-head">
				<div class="wrap">
					<h1 class="rise">{c.h1}</h1>
					<p class="lead measure rise rise-2">{c.lead}</p>
					<ul class="toc rise rise-3">
						{
							sections.map((s) => (
								<li>
									<a class="chip" href={`#${s.id}`}>
										{s.label}
									</a>
								</li>
							))
						}
					</ul>
				</div>
			</header>

			<section class="section" id="origin">
				<div class="wrap split">
					<header class="split-head"><h2>{c.origin.title}</h2></header>
					<div class="split-body prose measure">
						{c.origin.body.map((para) => <p>{para}</p>)}
					</div>
				</div>
			</section>

			<section class="section" id="naming">
				<div class="wrap split">
					<header class="split-head"><h2>{c.naming.title}</h2></header>
					<div class="split-body">
						<p class="measure">{c.naming.zh}</p>
						<div class="name-card">
							<p class="name-word" lang="en">Prisvalis</p>
							{c.naming.en.map((para) => <p>{para}</p>)}
						</div>
						<div class="table-scroll">
							<table>
								<caption>{c.naming.caption}</caption>
								<thead>
									<tr>
										<th scope="col">{c.naming.colRoot}</th>
										<th scope="col">{c.naming.colOrigin}</th>
										<th scope="col">{c.naming.colMeaning}</th>
									</tr>
								</thead>
								<tbody>
									{
										c.naming.roots.map((row) => (
											<tr>
												<th scope="row" class="mono" lang={row.lang}>
													{row.root}
												</th>
												<td>{row.origin}</td>
												<td>{row.meaning}</td>
											</tr>
										))
									}
								</tbody>
							</table>
						</div>
					</div>
				</div>
			</section>

			<section class="section" id="vision">
				<div class="wrap split">
					<header class="split-head"><h2>{c.vision.title}</h2></header>
					<div class="split-body">
						<p class="slogan">{c.vision.lead}</p>
						<ul class="mark-list">
							{c.vision.points.map((point) => <li>{point}</li>)}
						</ul>
					</div>
				</div>
			</section>

			<section class="section" id="timeline">
				<div class="wrap split">
					<header class="split-head"><h2>{c.timeline.title}</h2></header>
					<div class="split-body">
						<div class="table-scroll">
							<table class="narrow">
								<caption>{c.timeline.caption}</caption>
								<thead>
									<tr>
										<th scope="col">{c.timeline.colDate}</th>
										<th scope="col">{c.timeline.colEvent}</th>
									</tr>
								</thead>
								<tbody>
									{
										c.timeline.rows.map((row) => (
											<tr>
												<th scope="row" class="label-col">{row.label}</th>
												<td>{row.value}</td>
											</tr>
										))
									}
								</tbody>
							</table>
						</div>
					</div>
				</div>
			</section>

			<section class="section" id="profile">
				<div class="wrap split">
					<header class="split-head"><h2>{c.profile.title}</h2></header>
					<div class="split-body">
						<div class="table-scroll">
							<table class="narrow">
								<caption>{c.profile.caption}</caption>
								<thead>
									<tr>
										<th scope="col">{c.profile.colItem}</th>
										<th scope="col">{c.profile.colValue}</th>
									</tr>
								</thead>
								<tbody>
									{
										c.profile.rows.map((row) => (
											<tr>
												<th scope="row" class="label-col">{row.label}</th>
												<td>{row.value}</td>
											</tr>
										))
									}
								</tbody>
							</table>
						</div>
					</div>
				</div>
			</section>

			<section class="section" id="business">
				<div class="wrap split">
					<header class="split-head"><h2>{c.business.title}</h2></header>
					<div class="split-body">
						{
							[
								{ caption: c.business.captionCompany, rows: c.business.company },
								{ caption: c.business.captionTax, rows: c.business.tax },
							].map((group) => (
								<div class="table-scroll">
									<table class="narrow">
										<caption>{group.caption}</caption>
										<thead>
											<tr>
												<th scope="col">{c.business.colCode}</th>
												<th scope="col">{c.business.colName}</th>
											</tr>
										</thead>
										<tbody>
											{group.rows.map((row) => (
												<tr>
													<th scope="row" class="mono code">
														{row.code}
													</th>
													<td>{row.name}</td>
												</tr>
											))}
										</tbody>
									</table>
								</div>
							))
						}
						<div class="notice">
							<p>{c.business.note}</p>
						</div>
					</div>
				</div>
			</section>

			<section class="section">
				<div class="wrap split">
					<div class="split-head"></div>
					<div class="split-body source">
						<p>{c.source.text}</p>
						<ul class="mark-list">
							<li>
								<a href={FINDBIZ_URL} target="_blank" rel="noopener noreferrer">
									{c.source.findbiz}
									<span class="sr-only">{external}</span>
								</a>
							</li>
							<li>
								<a href={ETAX_URL} target="_blank" rel="noopener noreferrer">
									{c.source.etax}
									<span class="sr-only">{external}</span>
								</a>
							</li>
						</ul>
					</div>
				</div>
			</section>
		</main>

		<SiteFooter
			locale={locale}
			links={[
				{ href: homeHref, label: t(locale, "contact.back") },
				{ href: cooUrl(locale, "/"), label: COO_NAME },
				{ href: contactHref, label: t(locale, "nav.contact") },
			]}
		/>

		<style>
			.prose {
				display: grid;
				gap: var(--s-4);
				font-size: 1.0625rem;
			}

			/* 英文名稱：單一面板，名稱本身用標題字體放大。 */
			.name-card {
				display: grid;
				gap: var(--s-3);
				padding: var(--s-5);
				border: 1px solid var(--hairline);
				border-radius: var(--radius-m);
				background: var(--surface-1);
				color: var(--text-2);
			}
			.name-word {
				color: var(--text);
				font-family: var(--font-display);
				font-size: clamp(2rem, 4vw, 2.5rem);
				font-weight: 600;
				letter-spacing: -0.02em;
				line-height: 1.2;
			}

			/* 願景：一句大字，不加框。 */
			.slogan {
				font-family: var(--font-display);
				font-size: clamp(1.25rem, 2.4vw, 1.5rem);
				font-weight: 600;
				line-height: 1.5;
			}

			.mono {
				font-family: var(--font-mono);
				font-size: 0.875rem;
				font-weight: 400;
			}
			.code {
				white-space: nowrap;
			}
			/* 兩欄的資料表在窄螢幕上不需要橫向捲動。 */
			.table-scroll table.narrow {
				min-width: 0;
			}
			.label-col {
				width: 34%;
				color: var(--text-2);
				font-weight: 500;
			}

			.source {
				color: var(--text-2);
				font-size: 0.9375rem;
			}
		</style>
	</body>
</html>
