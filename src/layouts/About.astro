---
// 公司沿革。文案與登記資料在 src/i18n/about.ts，這裡只負責結構。
//
// 設計依 docs/brand-spec.md（Vignelli／瑞士國際主義 recipe）。與首頁同一套網格：
// 每個段落上方一條粗線、左上大號紅色編號、內容從第 3 欄開始；登記資料一律用表格。
// 整頁的色條標題放在公司基本資料。共用樣式在 styles/global.css。
import BaseHead from "../components/BaseHead.astro";
import MourningNotice from "../components/MourningNotice.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Phrase from "../components/Phrase.astro";
import { SITE, LOCALE_HOME_PATH, type Locale } from "../consts";
import { t } from "../i18n/ui";
import { cooUrl, COO_NAME } from "../i18n/coo";
import { about, ABOUT_PATH, FINDBIZ_URL, ETAX_URL } from "../i18n/about";

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const otherLocale: Locale = locale === "zh-Hant" ? "en" : "zh-Hant";
// canonical 與 hreflang 用絕對網址指向 SITE；站內連結一律相對路徑。
const alternates: Record<Locale, string> = {
	"zh-Hant": new URL(ABOUT_PATH["zh-Hant"], SITE).href,
	en: new URL(ABOUT_PATH.en, SITE).href,
};
const homeHref = LOCALE_HOME_PATH[locale];
const contactHref = locale === "en" ? "/en/contact/" : "/contact/";
const external = t(locale, "link.external");

const c = about[locale];

const sections = [
	{ id: "origin", label: c.origin.title },
	{ id: "naming", label: c.naming.title },
	{ id: "vision", label: c.vision.title },
	{ id: "timeline", label: c.timeline.title },
	{ id: "profile", label: c.profile.title },
	{ id: "business", label: c.business.title },
];

const nav = [
	{ href: homeHref, label: t(locale, "contact.back") },
	{ href: ABOUT_PATH[locale], label: c.navLabel, current: true },
	{ href: cooUrl(locale, "/"), label: COO_NAME },
	{ href: contactHref, label: t(locale, "nav.contact") },
];

const no = (i: number) => String(i).padStart(2, "0");
---

<!doctype html>
<html lang={t(locale, "html.lang")}>
	<head>
		<BaseHead locale={locale} title={c.metaTitle} description={c.metaDescription} alternates={alternates} />
	</head>
	<body>
		<MourningNotice locale={locale} />
		<SiteHeader locale={locale} homeHref={homeHref} switchHref={ABOUT_PATH[otherLocale]} nav={nav} />

		<main id="main">
			<header class="page-head">
				<div class="wrap grid">
					<h1><Phrase text={c.h1} /></h1>
					<p class="lead measure after-title">{c.lead}</p>
					<ul class="toc after-title">
						{
							sections.map((s, i) => (
								<li>
									<a href={`#${s.id}`}>
										{no(i + 1)} {s.label}
									</a>
								</li>
							))
						}
					</ul>
				</div>
			</header>

			<section class="section" id="origin">
				<div class="wrap grid">
					<p class="section-no" aria-hidden="true">{no(1)}</p>
					<div class="section-body">
						<h2>{c.origin.title}</h2>
						<div class="prose measure">
							{c.origin.body.map((para) => <p>{para}</p>)}
						</div>
					</div>
				</div>
			</section>

			<section class="section" id="naming">
				<div class="wrap grid">
					<p class="section-no" aria-hidden="true">{no(2)}</p>
					<div class="section-body">
						<h2>{c.naming.title}</h2>
						<p class="measure">{c.naming.zh}</p>
						<div class="name-block">
							<p class="name-word" lang="en">Prisvalis</p>
							<div class="measure">
								{c.naming.en.map((para) => <p>{para}</p>)}
							</div>
						</div>
						<div class="table-scroll">
							<table>
								<caption>{c.naming.caption}</caption>
								<thead>
									<tr>
										<th scope="col">{c.naming.colRoot}</th>
										<th scope="col">{c.naming.colOrigin}</th>
										<th scope="col">{c.naming.colMeaning}</th>
									</tr>
								</thead>
								<tbody>
									{
										c.naming.roots.map((row) => (
											<tr>
												<th scope="row" lang={row.lang}>
													{row.root}
												</th>
												<td>{row.origin}</td>
												<td>{row.meaning}</td>
											</tr>
										))
									}
								</tbody>
							</table>
						</div>
					</div>
				</div>
			</section>

			<section class="section" id="vision">
				<div class="wrap grid">
					<p class="section-no" aria-hidden="true">{no(3)}</p>
					<div class="section-body">
						<h2>{c.vision.title}</h2>
						<p class="slogan measure">{c.vision.lead}</p>
						<ol class="rule-list points">
							{c.vision.points.map((point, i) => (
								<li>
									<span class="point-no" aria-hidden="true">{no(i + 1)}</span>
									{point}
								</li>
							))}
						</ol>
					</div>
				</div>
			</section>

			<section class="section" id="timeline">
				<div class="wrap grid">
					<p class="section-no" aria-hidden="true">{no(4)}</p>
					<div class="section-body">
						<h2>{c.timeline.title}</h2>
						<div class="table-scroll">
							<table class="narrow">
								<caption>{c.timeline.caption}</caption>
								<thead>
									<tr>
										<th scope="col">{c.timeline.colDate}</th>
										<th scope="col">{c.timeline.colEvent}</th>
									</tr>
								</thead>
								<tbody>
									{
										c.timeline.rows.map((row) => (
											<tr>
												<th scope="row" class="label-col">{row.label}</th>
												<td>{row.value}</td>
											</tr>
										))
									}
								</tbody>
							</table>
						</div>
					</div>
				</div>
			</section>

			<section class="section" id="profile">
				<div class="wrap grid">
					<p class="section-no" aria-hidden="true">{no(5)}</p>
					<div class="section-body">
						<h2 class="bar-title">{c.profile.title}</h2>
						<div class="table-scroll">
							<table class="narrow">
								<caption>{c.profile.caption}</caption>
								<thead>
									<tr>
										<th scope="col">{c.profile.colItem}</th>
										<th scope="col">{c.profile.colValue}</th>
									</tr>
								</thead>
								<tbody>
									{
										c.profile.rows.map((row) => (
											<tr>
												<th scope="row" class="label-col">{row.label}</th>
												<td>{row.value}</td>
											</tr>
										))
									}
								</tbody>
							</table>
						</div>
					</div>
				</div>
			</section>

			<section class="section" id="business">
				<div class="wrap grid">
					<p class="section-no" aria-hidden="true">{no(6)}</p>
					<div class="section-body">
						<h2>{c.business.title}</h2>
						{
							[
								{ caption: c.business.captionCompany, rows: c.business.company },
								{ caption: c.business.captionTax, rows: c.business.tax },
							].map((group) => (
								<div class="table-scroll">
									<table class="narrow">
										<caption>{group.caption}</caption>
										<thead>
											<tr>
												<th scope="col">{c.business.colCode}</th>
												<th scope="col">{c.business.colName}</th>
											</tr>
										</thead>
										<tbody>
											{group.rows.map((row) => (
												<tr>
													<th scope="row" class="code">
														{row.code}
													</th>
													<td>{row.name}</td>
												</tr>
											))}
										</tbody>
									</table>
								</div>
							))
						}
						<div class="notice">
							<p>{c.business.note}</p>
						</div>
					</div>
				</div>
			</section>

			<section class="section">
				<div class="wrap grid">
					<div class="section-body source">
						<p>{c.source.text}</p>
						<ul class="rule-list">
							<li>
								<a href={FINDBIZ_URL} target="_blank" rel="noopener noreferrer">
									{c.source.findbiz}
									<span class="sr-only">{external}</span>
								</a>
							</li>
							<li>
								<a href={ETAX_URL} target="_blank" rel="noopener noreferrer">
									{c.source.etax}
									<span class="sr-only">{external}</span>
								</a>
							</li>
						</ul>
					</div>
				</div>
			</section>
		</main>

		<SiteFooter
			locale={locale}
			links={[
				{ href: homeHref, label: t(locale, "contact.back") },
				{ href: cooUrl(locale, "/"), label: COO_NAME },
				{ href: contactHref, label: t(locale, "nav.contact") },
			]}
		/>

		<style>
			/* 英文名稱：一個大字，下方細線，後面接說明。 */
			.name-block {
				padding-block: var(--s-3);
				border-top: var(--rule-thick) solid var(--rule);
				border-bottom: var(--rule-thin) solid var(--rule);
			}
			.name-word {
				font-size: clamp(2.5rem, 6vw, 4.5rem);
				font-weight: 700;
				line-height: 1.1;
				letter-spacing: -0.01em;
			}
			.name-block .measure {
				margin-top: var(--s-2);
			}
			.name-block .measure > * + * {
				margin-top: var(--s-1);
			}

			/* 願景：一句大字，下面是編號清單。 */
			.slogan {
				font-size: 1.5rem;
				font-weight: 700;
				line-height: 1.33;
			}
			.points li {
				display: grid;
				grid-template-columns: 3rem minmax(0, 1fr);
				column-gap: var(--col-gap);
				font-weight: 700;
			}
			.point-no {
				color: var(--accent);
				font-variant-numeric: tabular-nums;
			}

			.label-col {
				width: 34%;
			}
			.code {
				white-space: nowrap;
				font-variant-numeric: tabular-nums;
			}

			.source {
				color: var(--text-2);
				font-size: 0.875rem;
				line-height: 1.71;
			}
			@media (min-width: 760px) {
				.source {
					grid-column: 3 / -1;
				}
			}
		</style>
	</body>
</html>
